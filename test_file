def process_excel_sections(
    xlsx_path: str,
    *,
    transcript_store=None,
    non_transcript_store=None,
    excel_non_transcript_store=None,
    progress_cb: Optional[callable] = None
) -> str:
    """
    Iterates over all prompts for 'Key Highlights' and 'Group Performance',
    gathers responses using process_query, and combines them into a single HTML block.
    """
    df = pd.read_excel(xlsx_path)
    sections = {
        "Key Highlights": [],
        "Group Performance": []
    }
    # Find columns robustly
    key_col = next((c for c in df.columns if str(c).strip().lower() == "key highlights"), None)
    group_col = next((c for c in df.columns if str(c).strip().lower() == "group performance"), None)

    # Process all available prompts for each section
    total_prompts = 0
    processed_prompts = 0

    if key_col:
        key_prompts = df[key_col].dropna().astype(str).str.strip().tolist()
        total_prompts += len(key_prompts)
        for prompt in key_prompts:
            try:
                response = process_query(
                    prompt,
                    transcript_store=transcript_store,
                    non_transcript_store=non_transcript_store,
                    excel_non_transcript_store=excel_non_transcript_store
                )
            except Exception as e:
                response = f"Error: {str(e)}"
            sections["Key Highlights"].append(response)
            processed_prompts += 1
            if progress_cb:
                progress_cb(processed_prompts, total_prompts)

    if group_col:
        group_prompts = df[group_col].dropna().astype(str).str.strip().tolist()
        total_prompts += len(group_prompts)
        for prompt in group_prompts:
            try:
                response = process_query(
                    prompt,
                    transcript_store=transcript_store,
                    non_transcript_store=non_transcript_store,
                    excel_non_transcript_store=excel_non_transcript_store
                )
            except Exception as e:
                response = f"Error: {str(e)}"
            sections["Group Performance"].append(response)
            processed_prompts += 1
            if progress_cb:
                progress_cb(processed_prompts, total_prompts)

    # Build HTML
    html_parts = []
    if sections["Key Highlights"]:
        html_parts.append("<h2>Key Highlights</h2><ul>")
        for resp in sections["Key Highlights"]:
            html_parts.append(f"<li>{resp}</li>")
        html_parts.append("</ul>")
    if sections["Group Performance"]:
        html_parts.append("<h2>Group Performance</h2><ul>")
        for resp in sections["Group Performance"]:
            html_parts.append(f"<li>{resp}</li>")
        html_parts.append("</ul>")

    return "\n".join(html_parts)

