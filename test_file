import re
import pandas as pd
import logging

logger = logging.getLogger('EarningsAnalysis')

BANK_CODE_SYNONYMS = {
    "CITI": "C",
    "CITIGROUP": "C",
    "CITI_GROUP": "C",
    "CITIGRP": "C",
}
SINGLE_LETTER_BANK_CODES = {"C"}  # allow C

def _load_metric_map_df(records: list[dict]) -> pd.DataFrame:
    """
    Load metric mapping ONLY from OData API (bankID/stdMetric/bankMetric).
    Excel fallback removed by requirement.
    """
    if not records:
        logger.warning("Metric mapper: no records returned from API (no Excel fallback).")
        return pd.DataFrame()

    df = pd.DataFrame(records)

    # Normalize expected columns
    rename = {}
    lower = {c.lower(): c for c in df.columns}
    for src, tgt in [("bankid", "bankID"), ("stdmetric", "stdMetric"), ("bankmetric", "bankMetric")]:
        if src in lower:
            rename[lower[src]] = tgt
    if rename:
        df = df.rename(columns=rename)

    required = {"bankID", "stdMetric", "bankMetric"}
    if not required.issubset(df.columns):
        logger.warning(f"Metric mapper: missing required columns {required - set(df.columns)} (no fallback).")
        return pd.DataFrame()

    # Clean & filter
    for c in required:
        df[c] = df[c].astype(str).str.strip()
    df = df[(df["bankID"] != "") & (df["stdMetric"] != "") & (df["bankMetric"] != "")]
    if df.empty:
        logger.warning("Metric mapper: all rows empty after cleaning (no fallback).")
    return df

def _tokenize_prompt(prompt: str) -> list[str]:
    return re.findall(r"[A-Za-z0-9]+", prompt.upper())

def _canonical_bank_codes(df: pd.DataFrame) -> set[str]:
    raw = {str(b).strip() for b in df.get("bankID", []) if str(b).strip()}
    canon = set()
    for b in raw:
        up = b.upper()
        up = BANK_CODE_SYNONYMS.get(up, up)
        if len(up) > 1 or up in SINGLE_LETTER_BANK_CODES:
            canon.add(up)
    return canon

def _detect_bank_codes_in_prompt(prompt: str, records: list[dict]) -> list[str]:
    df = _load_metric_map_df(records)
    if df.empty:
        return []
    codes = _canonical_bank_codes(df)
    tokens = {BANK_CODE_SYNONYMS.get(t, t) for t in _tokenize_prompt(prompt)}
    return sorted([c for c in codes if c in tokens])

def _load_metric_maps_for_banks(bank_codes: list[str], records: list[dict]) -> dict[str, dict]:
    df = _load_metric_map_df(records)
    if df.empty:
        return {}
    def _norm(b: str) -> str:
        up = b.upper()
        return BANK_CODE_SYNONYMS.get(up, up)
    df["__BC"] = df["bankID"].map(_norm)
    maps: dict[str, dict] = {}
    for bc in bank_codes:
        sub = df[df["__BC"] == bc.upper()]
        if not sub.empty:
            maps[bc] = dict(zip(sub["stdMetric"], sub["bankMetric"]))
    return maps

def _replace_case_insensitive(text: str, needle: str, replacement: str) -> str:
    pattern = re.compile(rf"\b{re.escape(needle)}\b", flags=re.IGNORECASE)
    return pattern.sub(replacement, text)

def map_prompt_multi_bank(prompt: str, records: list[dict]) -> str:
    banks = _detect_bank_codes_in_prompt(prompt, records)
    if not banks:
        logger.warning(f"No bank codes found in prompt: {prompt}")
        return prompt
    
    bank_maps = _load_metric_maps_for_banks(banks, records)
    if not bank_maps:
        logger.warning(f"No metric maps found for banks {banks} in prompt: {prompt}")
        return prompt
    lp = prompt.lower()
    std_present = set()
    for m in bank_maps.values():
        for std in m:
            if std.lower() in lp:
                std_present.add(std)

    if not std_present:
        logger.info("No standard metrics found in prompt; unchanged.")
        return prompt
    
    modified = prompt
    
    for std in sorted(std_present, key=len, reverse=True):
        per_bank = []
        for bc in banks:
            mapped = bank_maps.get(bc, {}).get(std)
            if mapped:
                per_bank.append(f"{mapped} ({bc})" if len(banks) > 1 else mapped)
        if per_bank:
            modified = _replace_case_insensitive(modified, std, ", ".join(per_bank))
    if modified != prompt:
        logger.info(f"Prompt mapping: '{prompt}' -> '{modified}'")
    return modified

