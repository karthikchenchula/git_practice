def _find_prompt_col(df: pd.DataFrame) -> Optional[str]:
    for c in df.columns:
        if str(c).strip().lower() == "prompt":
            return c
    return None

def _clean_prompt_text(prompt: str) -> str:
    """Remove redundant Bank/Period prefixes from prompt text.
    
    Many Excel prompts contain:
        Bank: GS
        Period: 4Q25
        Prompt: <actual question>
    
    This function extracts only the actual question after 'Prompt:' to avoid token bloat.
    """
    if not prompt:
        return prompt
    
    # Pattern 1: Extract text after "Prompt:" label
    prompt_match = re.search(r'Prompt:\s*(.+)', prompt, re.IGNORECASE | re.DOTALL)
    if prompt_match:
        return prompt_match.group(1).strip()
    
    # Pattern 2: Remove lines starting with "Bank:" or "Period:"
    lines = prompt.split('\n')
    cleaned_lines = [
        line.strip() for line in lines 
        if not re.match(r'^\s*(Bank|Period)\s*:', line, re.IGNORECASE)
    ]
    cleaned = '\n'.join(cleaned_lines).strip()
    
    return cleaned if cleaned else prompt

def extract_prompts_from_excel(xlsx_path: str) -> List[Dict[str, Any]]:
    df = pd.read_excel(xlsx_path)
    pcol = _find_prompt_col(df)
    if not pcol:
        return []

    out: List[Dict[str, Any]] = []
    for idx, row in df.iterrows():
        val = row.get(pcol, None)
        if pd.isna(val):
            continue
        raw = str(val).strip()
        if not raw or raw.lower() == "nan":
            continue
        # Clean redundant Bank/Period prefixes
        cleaned = _clean_prompt_text(raw)
        out.append({
            "row_index": int(idx),
            "prompt": cleaned,
            "input_message": cleaned,  # ONLY the actual question
        })
    return out

