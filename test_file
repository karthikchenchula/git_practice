def _utcnow_naive():
    return datetime.now(timezone.utc).replace(tzinfo=None)

def _ensure_bytes(obj) -> bytes:
    if isinstance(obj, bytes):
        return obj
    if isinstance(obj, bytearray):
        return bytes(obj)
    if isinstance(obj, memoryview):
        return obj.tobytes()
    return bytes(obj)


