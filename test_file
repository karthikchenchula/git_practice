# --- Added by Niladri for parsing JSON in multiprompt--------
def _safe_parse_json(raw: str) -> Dict:
    """Attempt robust JSON parsing; handle control chars in JSON strings."""
    cleaned = raw.strip()
    # Remove markdown code fences if present
    cleaned = re.sub(r'^```(?:json)?\s*|\s*```$', '', cleaned)
    
    # Try parsing as-is first
    try:
        return json.loads(cleaned)
    except json.JSONDecodeError:
        pass
    
    # Second attempt: Escape literal control chars (newlines, tabs, etc.)
    # This handles cases where LLM returns JSON with unescaped newlines in string values
    try:
        escaped = cleaned.replace('\n', '\\n').replace('\r', '\\r').replace('\t', '\\t')
        return json.loads(escaped)
    except json.JSONDecodeError:
        pass
    
    # Third attempt: Strip all control characters (nuclear option)
    try:
        stripped = re.sub(r'[\x00-\x1F]', ' ', cleaned)
        return json.loads(stripped)
    except json.JSONDecodeError:
        pass
    
    # Final fallback: extract first JSON object block and try all strategies
    m = re.search(r'\{.*\}', cleaned, re.DOTALL)
    if m:
        for strategy in [
            lambda s: s,  # as-is
            lambda s: s.replace('\n', '\\n').replace('\r', '\\r').replace('\t', '\\t'),  # escape
            lambda s: re.sub(r'[\x00-\x1F]', ' ', s)  # strip
        ]:
            try:
                return json.loads(strategy(m.group(0)))
            except Exception:
                pass
    raise ValueError("Unable to parse JSON after multiple attempts")
def _expand_bank_codes_in_prompt(query: str) -> str:
    """Expand bank codes to CODE(Name) inline based on live OData fetch (no caching)."""
    if not query:
        return query
    bank_map = fetch_bank_details_from_odata() or {}
    if not bank_map:
        return query
    # Build pattern for all codes (word boundary match)
    codes = sorted(bank_map.keys(), key=len, reverse=True)
    pattern = re.compile(r'\b(' + '|'.join(re.escape(c) for c in codes) + r')\b')

    def repl(m):
        code = m.group(1)
        # Skip if already expanded (next char is '(')
        if query[m.end():m.end()+1] == '(':
            return code
        name = bank_map.get(code, "")
        return f"{code}({name})" if name else code

    return pattern.sub(repl, query)

def process_query(
    query: str,
    transcript_store: Optional[HanaDB] = None,
    non_transcript_store: Optional[HanaDB] = None,
    excel_non_transcript_store: Optional[HanaDB] = None,
    db_connection = None,
    action: str = "Chat",
    files: list = None
) -> str:
    """Handle query processing with parallel retrieval, image processing, and Excel query execution.
    
    Args:
        query: User query string
        transcript_store: Vector store for transcript documents
        non_transcript_store: Vector store for non-transcript documents  
        excel_non_transcript_store: Vector store for Excel data
        db_connection: Database connection for direct SQL queries (used for Summary action)
        action: Action type - "Chat", "Chat with Files", or "Summary"
        files: List of filenames to filter by (for "Chat with Files" or "Summary" actions)
    """
    # Handle Summary action early (doesn't need a query message)
    if action == "Summary":
        logger.info(f"Processing Summary action for files: {files}")
        if not files or files == "empty":
            return "Error: Summary action requires at least one file to be specified."
        
        if not db_connection:
            return "Error: Database connection is not available for summary retrieval. Please contact administrator."
        
        try:
            # Fetch pre-generated summaries directly from CONTENT_INGESTION_SUMMARY_FILE table
            # Return raw BLOB content without any additional processing
            summary_content = fetch_summary_from_db(db_connection, files)
            
            # Return raw summary without additional HTML wrapping
            return summary_content
            
        except Exception as e:
            logger.error(f"Error retrieving summary: {str(e)}")
            return f"Error retrieving summary: {str(e)}"
    
    # For Chat actions, validate query and vector stores
    if not query:
        logger.info("No query provided")
        return "Error: No query provided."
    
    if not all([non_transcript_store]):
        logger.info("Missing vector stores")
        return "Error: vector stores required.."

    # Expand bank codes in prompt
    original_query = query
    query = _expand_bank_codes_in_prompt(query)
    if query != original_query:
        logger.debug(f"Bank codes expanded: '{original_query}' -> '{query}'")

    try:
        # Extract bank codes from query AND filenames
        from text_processor import extract_all_banks_from_query
        
        # Get banks from query text
        banks_from_query = extract_all_banks_from_query(query)
        
        # Get banks from filenames if provided
        banks_from_filenames = _extract_banks_from_filenames(files) if files else []
        
        # Combine banks from both sources (deduplicate)
        all_banks = banks_from_query or []
        for bank_tuple in banks_from_filenames:
            # Check if this bank is already in the list (case-insensitive)
            bank_code_upper = bank_tuple[0].upper()
            if not any(b[0].upper() == bank_code_upper for b in all_banks):
                all_banks.append(bank_tuple)
        
        # Log extraction results
        if banks_from_query:
            logger.info(f"Banks extracted from query: {[f'{code}({name})' for code, name in banks_from_query]}")
        if banks_from_filenames:
            logger.info(f"Banks extracted from filenames: {[f'{code}({name})' for code, name in banks_from_filenames]}")
        
        # Determine retrieval strategy: prioritize FILES over BANKS when files are explicitly provided
        bank_info = None
        bank_list = None
        
        print(f"\n{'='*60}")
        print(f"[process_query] RETRIEVAL STRATEGY DETERMINATION")
        print(f"{'='*60}")
        print(f"Files parameter: {files}")
        print(f"All banks extracted: {all_banks}")
        print(f"{'='*60}\n")
        
        # CRITICAL: When user selects "Chat with Files", use FILE-based retrieval, not BANK-based
        # This ensures we only search within the specified files, not all bank documents
        if files and len(files) > 1:
            # Multi-file mode: Use file-based retrieval (banks are only for validation)
            logger.info(f"Multi-file mode: Will retrieve from {len(files)} specific files only")
            print(f"[process_query] ➤ MODE: Multi-file ({len(files)} files)")
