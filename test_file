def _extract_banks_from_filenames(filenames: list) -> list:
    """Extract bank codes from filenames.
    
    Args:
        filenames: List of filenames (e.g., ["JPMC 4Q'25 - press release.pdf", "Citi 4Q'25 - financial supplement.pdf"])
        
    Returns:
        List of tuples [(bank_code, bank_name)] extracted from filenames
    """
    if not filenames:
        return []
    
    # Fetch bank mapping from OData
    bank_map = fetch_bank_details_from_odata()
    if not bank_map:
        logger.warning("No bank mapping available for filename extraction")
        return []
    
    extracted_banks = []
    seen_banks = set()  # Track unique banks
    
    for filename in filenames:
        filename_upper = filename.upper()
        
        # Check each bank code in the mapping
        for bank_code, bank_name in bank_map.items():
            bank_code_upper = bank_code.upper()
            bank_name_upper = bank_name.upper()
            
            # Determine if this is a short code requiring stricter matching
            is_short_code = len(bank_code_upper) <= 2
            
            matched = False
            
            # For SHORT codes (1-2 chars), SKIP code matching entirely in filenames
            # Only match the FULL bank name to avoid false positives like 'C' in 'BCS-Q42025'
            if is_short_code:
                logger.debug(f"Short code '{bank_code_upper}' - will only match full bank name '{bank_name_upper}'")
            else:
                # For longer codes (3+ chars), match the code with word boundaries
                bank_code_pattern = r'\b' + re.escape(bank_code_upper) + r'\b'
                if re.search(bank_code_pattern, filename_upper):
                    matched = True
                    logger.debug(f"Long code '{bank_code_upper}' matched in '{filename}'")
            
            # Check full bank name (case-insensitive, exact substring)
            if not matched:
                if bank_name_upper in filename_upper:
                    matched = True
                    logger.debug(f"Bank name '{bank_name_upper}' matched in '{filename}'")
                else:
                    # Check variations (no spaces, underscores)
                    name_no_space = bank_name_upper.replace(' ', '')
                    name_with_underscore = bank_name_upper.replace(' ', '_')
                    
                    # For short bank names, require longer length to avoid false matches
                    min_length = 4 if is_short_code else 3
                    
                    if (name_no_space in filename_upper and len(name_no_space) >= min_length) or \
                       (name_with_underscore in filename_upper and len(name_with_underscore) >= min_length):
                        matched = True
                        logger.debug(f"Bank name variation matched for '{bank_name_upper}' in '{filename}'")
            
            if matched:
                bank_key = (bank_code.upper(), bank_name.upper())
                if bank_key not in seen_banks:
                    extracted_banks.append((bank_code, bank_name))
                    seen_banks.add(bank_key)
                    logger.info(f"Extracted bank from filename '{filename}': {bank_code} ({bank_name})")
                    break  # Only match one bank per filename
        
        # Log if no bank was found for this file (moved after the loop)
        if not any(filename.upper() in str(seen_banks).upper() for _ in [1]):  # Simple check
            # Check if any bank was extracted from this specific file
            file_had_match = False
            for bank_code_check, bank_name_check in extracted_banks:
                # This is a simplified check - just see if we have any banks
                file_had_match = True
                break
            if not file_had_match or len(extracted_banks) == 0:
                logger.warning(f"No bank code found in filename: '{filename}'")
                logger.debug(f"  Checked against {len(bank_map)} bank codes. Filename uppercase: {filename_upper}")
    
    result_msg = f"Extracted {len(extracted_banks)} unique banks: {[(c, n) for c, n in extracted_banks]}" if extracted_banks else "No banks extracted from filenames"
    logger.info(f"_extract_banks_from_filenames: {result_msg}")
    print(f"[_extract_banks_from_filenames] RESULT: {result_msg}")
    print(f"[_extract_banks_from_filenames] Input filenames: {filenames}")
    print(f"[_extract_banks_from_filenames] Output: {extracted_banks}")
    return extracted_banks


def fetch_summary_from_db(db_conn, filenames: list) -> str:
    """Fetch pre-generated summary from CONTENT_INGESTION_SUMMARY_FILE table.
    
    Args:
        db_conn: Database connection
        filenames: List of filenames to fetch summaries for
        
    Returns:
        Raw BLOB content from SUMMARY_SUMMHAY column without any processing
    """
    if not db_conn or not filenames:
        return "No summary available."
    
    cursor = None
    try:
        cursor = db_conn.cursor()
        summary_table = TABLE_NAMES['summary_content']
        
        summaries = []
        for filename in filenames:
            # Query by ORIGINAL_FILENAME to get SUMMARY_SUMMHAY BLOB
            query = f"""
                SELECT ORIGINAL_FILENAME, SUMMARY_SUMMHAY 
                FROM {summary_table}
                WHERE ORIGINAL_FILENAME = ?
            """
            cursor.execute(query, (filename,))
            result = cursor.fetchone()
            
            if result:
                original_filename = result[0]
                summary_blob = result[1]
                
                # Return raw BLOB content without any processing
                if summary_blob:
                    # Handle memoryview, bytes, or string types - minimal conversion
                    if isinstance(summary_blob, memoryview):
                        blob_bytes = summary_blob.tobytes()
                    elif isinstance(summary_blob, bytes):
                        blob_bytes = summary_blob
                    else:
                        # Already a string
                        summaries.append(str(summary_blob))
                        logger.info(f"Retrieved summary for {original_filename} (string type)")
                        continue
                    
                    # Decode bytes to string with UTF-8 (no encoding fallback, no processing)
                    try:
                        summary_text = blob_bytes.decode('utf-8')
                        summaries.append(summary_text)
                        logger.info(f"Retrieved raw summary for {original_filename} ({len(summary_text)} chars)")
                    except UnicodeDecodeError:
                        # If UTF-8 fails, use error handling
                        summary_text = blob_bytes.decode('utf-8', errors='replace')
                        summaries.append(summary_text)
                        logger.warning(f"Retrieved summary for {original_filename} with replacement characters")
                else:
                    summaries.append(f"No summary content available for {original_filename}")
                    logger.warning(f"No summary content for {original_filename}")
            else:
                logger.warning(f"No summary found for filename: {filename}")
                summaries.append(f"No summary found in database for {filename}")
        
        if summaries:
            return "\n\n".join(summaries)
        else:
            return "No summaries found for the specified files."
            
    except Exception as e:
        logger.error(f"Error fetching summary from database: {str(e)}")
        return f"Error retrieving summary: {str(e)}"
    finally:
        if cursor:
            cursor.close()

