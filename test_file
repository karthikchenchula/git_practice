def _fetch_context_for_single_bank(retriever, query: str, k: int, bank_info: tuple, files: list = None):
    """Fetch documents for a single bank (helper for multi-bank comparison)."""
    bank_code, bank_name = bank_info
    
    # Build search query with file terms if provided
    search_query = query
    if files:
        file_terms = []
        for filename in files:
            terms = re.findall(r'[A-Za-z0-9]+', filename.replace('.pdf', ''))
            file_terms.extend(terms)
        file_context = ' '.join(file_terms)
        search_query = f"{query} {file_context}"
    
    # Add bank name to search query to help retrieval
    search_query = f"{search_query} {bank_name}"
    
    # Retrieve with higher k to account for filtering
    original_k = retriever.search_kwargs.get('k', k)
    retriever.search_kwargs['k'] = min(k * 5, 150)  # Get more candidates for filtering
    
    docs = retriever.invoke(search_query)
    
    # Reset k
    retriever.search_kwargs['k'] = original_k
    
    # Filter by bank
    filtered_docs = _filter_docs_by_bank(docs, bank_code, bank_name)
    
    # Apply file filtering if provided
    if files:
        files_upper = [f.upper() for f in files]
        file_filtered_docs = []
        for doc in filtered_docs:
            doc_filename = (doc.metadata.get('filename', '') or 
                           doc.metadata.get('source_file', '') or
                           doc.metadata.get('file_name', '') or
                           doc.metadata.get('source', ''))
            
            for file_filter in files_upper:
                if file_filter in doc_filename.upper() or doc_filename.upper() in file_filter:
                    file_filtered_docs.append(doc)
                    break
        
        filtered_docs = file_filtered_docs if file_filtered_docs else filtered_docs
    
    # Return top k documents
    return filtered_docs[:k]

def _fetch_context_for_single_file(retriever, query: str, k: int, file: str, bank_info: tuple = None):
    """Fetch documents for a single file (helper for multi-file comparison)."""
    # Build search query with file terms
    file_terms = re.findall(r'[A-Za-z0-9]+', file.replace('.pdf', ''))
    file_context = ' '.join(file_terms)
    search_query = f"{query} {file_context}"
    
    # Retrieve with higher k to account for filtering
    original_k = retriever.search_kwargs.get('k', k)
    retriever.search_kwargs['k'] = min(k * 5, 150)  # Get more candidates for filtering
    
    docs = retriever.invoke(search_query)
    
    # Reset k
    retriever.search_kwargs['k'] = original_k
    
    # Filter by file
    file_upper = file.upper()
    filtered_docs = []
    for doc in docs:
        doc_filename = (doc.metadata.get('filename', '') or 
                       doc.metadata.get('source_file', '') or
                       doc.metadata.get('file_name', '') or
                       doc.metadata.get('source', ''))
        
        if file_upper in doc_filename.upper() or doc_filename.upper() in file_upper:
            filtered_docs.append(doc)
    
    # Apply bank filtering if provided (for queries like "JPMC file1.pdf vs Citi file2.pdf")
    if bank_info:
        bank_code, bank_name = bank_info
        filtered_docs = _filter_docs_by_bank(filtered_docs, bank_code, bank_name)
    
    # Return top k documents
    return filtered_docs[:k]


def fetch_context(retriever, query: str, k: int = None, bank_info: tuple = None, bank_list: list = None, files: list = None) -> str:
    """Retrieve documents with minimal memory usage, optionally filtered by bank code/name and/or specific files.
    
    Args:
        retriever: Vector store retriever
        query: Search query
        k: Number of documents to retrieve (will be split equally if multiple banks or files). Defaults to 15 for Excel mode, 30 for Chat mode.
        bank_info: Tuple of (bank_code, bank_name) for single bank filtering, e.g., ('C', 'Citi')
        bank_list: List of tuples [(bank_code1, bank_name1), (bank_code2, bank_name2)] for multi-bank comparison
        files: List of filenames to filter by, e.g., ['JPMC Q4 prese.pdf', 'BSR weekly.pdf']
        
    Note:
        - Multi-bank: k is split equally across banks (e.g., k=15 with 3 banks = 5 docs per bank)
        - Multi-file: k is split equally across files (e.g., k=15 with 3 files = 5 docs per file)
        - Ensures equal representation when comparing multiple banks or files
    """
    # Default k based on mode
    if k is None:
        k = 15 if is_excel_prompt_mode() else 30  # More aggressive: 15 for Excel, 30 for Chat
    
    # Track whether per-entity (bank/file) truncation was already applied
    per_entity_truncation_applied = False
    
    print(f"\n{'='*70}")
    print(f"[fetch_context] ===== START RETRIEVAL =====")
    print(f"[fetch_context] Query: '{query[:80]}'")
    print(f"[fetch_context] k={k}")
    print(f"[fetch_context] bank_info={bank_info}")
    print(f"[fetch_context] bank_list={bank_list}")
    print(f"[fetch_context] files={files}")
    print(f"[fetch_context] Store type: {type(retriever).__name__}")
    print(f"{'='*70}\n")
    
    try:
        # CRITICAL: Prioritize FILES over BANKS when both are provided
        # When user selects "Chat with Files", they want to search ONLY those files, not all bank documents
        
        # Handle multi-file comparison with equal distribution (HIGHEST PRIORITY)
        if files and len(files) > 1:
            logger.info(f"Multi-file comparison detected: {len(files)} files - splitting k={k} equally")
            k_per_file = max(1, (k // len(files))*2)  # At least 1 doc per file
            logger.info(f"Retrieving {k_per_file} documents per file for equal representation")
            
            # Calculate per-file context limit for balanced representation
            MAX_CONTEXT_LENGTH = 15000 if is_excel_prompt_mode() else 30000
            max_context_per_file = MAX_CONTEXT_LENGTH // len(files)  # Fair share per file
            logger.info(f"Per-file context limit: {max_context_per_file} chars")
            
            per_entity_truncation_applied = True  # Mark that per-file truncation is applied
            
            all_docs = []
            for file in files:
                # Retrieve documents for each file separately
                logger.info(f"Fetching {k_per_file} docs from file: {file}")
                file_docs = _fetch_context_for_single_file(
                    retriever, query, k_per_file, file, bank_info
                )
                # If returned string (error), log and continue
                if isinstance(file_docs, str):
                    logger.warning(f"Could not fetch docs from {file}: {file_docs[:100]}")
                    continue
                
                # Apply per-file truncation to ensure balanced representation
                if file_docs:
                    file_context = format_documents(file_docs)
                    if len(file_context) > max_context_per_file:
                        logger.warning(f"File '{file}' context {len(file_context)} chars exceeds limit {max_context_per_file}, truncating")
                        # Binary search for optimal doc count for this file
                        left, right = 1, len(file_docs)
                        optimal_file_docs = file_docs
                        while left <= right:
                            mid = (left + right) // 2
                            test_context = format_documents(file_docs[:mid])
                            if len(test_context) <= max_context_per_file:
                                optimal_file_docs = file_docs[:mid]
                                left = mid + 1
                            else:
                                right = mid - 1
                        file_docs = optimal_file_docs
                        logger.info(f"Truncated file '{file}' to {len(file_docs)} docs ({len(format_documents(file_docs))} chars)")
                    
                    all_docs.extend(file_docs)
                    logger.info(f"Retrieved {len(file_docs)} docs from {file}")
            
            if not all_docs:
                return f"No documents found in the specified files: {', '.join(files)}. Data not available."
            
            docs = all_docs
            logger.info(f"Total documents retrieved across {len(files)} files: {len(docs)}")
        
        # Handle multi-bank comparison with equal distribution (ONLY when no files specified)
        elif bank_list and len(bank_list) > 1:
            logger.info(f"Multi-bank comparison detected: {len(bank_list)} banks - splitting k={k} equally")
            k_per_bank = max(1, (k // len(bank_list))*2)  # At least 1 doc per bank
            logger.info(f"Retrieving {k_per_bank} documents per bank for equal representation")
            
            # Calculate per-bank context limit for balanced representation
            MAX_CONTEXT_LENGTH = 15000 if is_excel_prompt_mode() else 30000
            max_context_per_bank = MAX_CONTEXT_LENGTH // len(bank_list)  # Fair share per bank
            logger.info(f"Per-bank context limit: {max_context_per_bank} chars")
            
            per_entity_truncation_applied = True  # Mark that per-bank truncation is applied
            
            all_docs = []
            for bank_code, bank_name in bank_list:
                # Retrieve documents for each bank separately
                logger.info(f"Fetching {k_per_bank} docs for {bank_code} ({bank_name})")
                bank_docs = _fetch_context_for_single_bank(
                    retriever, query, k_per_bank, (bank_code, bank_name), files
                )
                # If returned string (error), log and continue
                if isinstance(bank_docs, str):
                    logger.warning(f"Could not fetch docs for {bank_name}: {bank_docs[:100]}")
                    continue
                
                # Apply per-bank truncation to ensure balanced representation
                if bank_docs:
                    bank_context = format_documents(bank_docs)
                    if len(bank_context) > max_context_per_bank:
                        logger.warning(f"Bank '{bank_name}' context {len(bank_context)} chars exceeds limit {max_context_per_bank}, truncating")
                        # Binary search for optimal doc count for this bank
                        left, right = 1, len(bank_docs)
                        optimal_bank_docs = bank_docs
                        while left <= right:
                            mid = (left + right) // 2
                            test_context = format_documents(bank_docs[:mid])
                            if len(test_context) <= max_context_per_bank:
                                optimal_bank_docs = bank_docs[:mid]
                                left = mid + 1
                            else:
                                right = mid - 1
                        bank_docs = optimal_bank_docs
                        logger.info(f"Truncated bank '{bank_name}' to {len(bank_docs)} docs ({len(format_documents(bank_docs))} chars)")
                    
                    all_docs.extend(bank_docs)
                    logger.info(f"Retrieved {len(bank_docs)} docs for {bank_name}")
            
            if not all_docs:
                available_banks = ', '.join([name for _, name in bank_list])
                return f"No documents found for the specified banks: {available_banks}. Data not available."
            
            docs = all_docs
            logger.info(f"Total documents retrieved across {len(bank_list)} banks: {len(docs)}")
        
        # Handle single bank or single file or no filtering
        else:
            # Build search query with bank name to improve retrieval
            search_query = query
            if bank_info:
                bank_code, bank_name = bank_info
                # For short bank codes, add the full bank name to search query to improve retrieval
                is_short_code = len(bank_code) <= 2
                if is_short_code:
                    search_query = f"{query} {bank_name}"
                    logger.info(f"Enhanced search query with bank name for short code '{bank_code}': '{search_query[:100]}'")
            
            if files:
                # Extract key terms from filenames (bank names, periods)
                file_terms = []
                for filename in files:
                    # Extract alphanumeric terms from filename (strip .pdf, remove special chars)
                    terms = re.findall(r'[A-Za-z0-9]+', filename.replace('.pdf', ''))
                    file_terms.extend(terms)
                
                # Combine query with file terms
                file_context = ' '.join(file_terms)
                search_query = f"{search_query} {file_context}"
                logger.info(f"File filtering enabled - enhanced query with filename terms: '{search_query}'")
                # Increase k to get more candidates when filtering by files
                original_k = retriever.search_kwargs.get('k', k)
                retriever.search_kwargs['k'] = min(k * 3, 150)  # Get more docs to filter from
            elif bank_info:
                # Increase k for bank filtering to get more candidates
                original_k = retriever.search_kwargs.get('k', k)
                retriever.search_kwargs['k'] = min(k * 5, 150)  # Get more candidates for filtering
                logger.info(f"Increased k to {retriever.search_kwargs['k']} for bank filtering")
            
            docs = retriever.invoke(search_query)
            logger.info(f"Retrieved {len(docs)} documents before bank/file filtering")
            
            # Reset k to original value
            if files or bank_info:
                retriever.search_kwargs['k'] = original_k
            
            # Apply single bank filtering if provided
            if bank_info:
                bank_code, bank_name = bank_info
                logger.info(f"Fetching context with bank filter: {bank_code} ({bank_name})")
                # Post-filter results to only include documents from the specified bank
                filtered_docs = _filter_docs_by_bank(docs, bank_code, bank_name)
                
                if not filtered_docs:
                    logger.warning(f"No documents found for bank: {bank_code} ({bank_name})")
                    return f"No documents found for bank: {bank_name}. Data not available."
                
                docs = filtered_docs
                logger.info(f"Filtered to {len(filtered_docs)} documents for bank {bank_code} ({bank_name})")
            
            # Apply file filtering if provided
            if files:
                logger.info(f"Fetching context with file filter: {files}")
                # Log what documents were retrieved before filtering
                if docs:
                    retrieved_filenames = [doc.metadata.get('filename', 'NO_FILENAME') for doc in docs[:10]]
                    logger.info(f"Retrieved {len(docs)} documents. First 10 filenames: {retrieved_filenames}")
                
                # Normalize file names for comparison (case-insensitive)
                files_upper = [f.upper() for f in files]
                filtered_docs = []
                for doc in docs:
                    # Check multiple possible metadata field names
                    doc_filename = (doc.metadata.get('filename', '') or 
                                   doc.metadata.get('source_file', '') or
                                   doc.metadata.get('file_name', '') or
                                   doc.metadata.get('source', ''))
                    
                    # Check if document's filename matches any of the specified files
                    matched = False
                    for file_filter in files_upper:
                        if file_filter in doc_filename.upper() or doc_filename.upper() in file_filter:
                            filtered_docs.append(doc)
                            matched = True
                            logger.debug(f"✓ Matched: '{doc_filename}' with filter '{file_filter}'")
                            break
                
                if not filtered_docs:
                    logger.warning(f"No documents found for files: {files}")
                    # Log available filenames for debugging
                    sample_filenames = [doc.metadata.get('filename', 'NO_FILENAME') for doc in docs[:10]]
                    logger.warning(f"Available filenames in retrieved docs: {sample_filenames}")
                    return f"No documents found for the specified files: {', '.join(files)}. Data not available."
                
                docs = filtered_docs
                logger.info(f"Filtered to {len(filtered_docs)} documents for files {files}")
        
        # Apply period/year filtering based on query
        # Extract year and quarter from query (e.g., "Q4 2025", "4Q25", "2025")
        period_patterns = [
            r'Q([1-4])\s*20(\d{2})',  # Q4 2025, Q1 2024
            r'([1-4])Q(\d{2})',       # 4Q25, 1Q24
            r'20(\d{2})\s*Q([1-4])',  # 2025 Q4
            r'\b(20\d{2})\b'          # Just year: 2025, 2024
        ]
        
        extracted_period = None
        for pattern in period_patterns:
            match = re.search(pattern, query, re.IGNORECASE)
            if match:
                if len(match.groups()) == 2:
                    # Has quarter and year
                    q, y = match.groups()
                    # Normalize year to 4 digits
                    year = f"20{y}" if len(y) == 2 else (y if len(y) == 4 else f"20{y}")
                    extracted_period = f"Q{q} {year}"
                    logger.info(f"Extracted period from query: {extracted_period}")
                elif len(match.groups()) == 1:
                    # Just year
                    year = match.group(1)
                    extracted_period = year
                    logger.info(f"Extracted year from query: {extracted_period}")
                break
        
        if extracted_period:
            # Filter documents by period
            filtered_docs = []
            for doc in docs:
                doc_period = doc.metadata.get('period', '')
                # Match either exact period (Q4 2025) or just year (2025)
                if extracted_period in doc_period or doc_period.endswith(extracted_period):
                    filtered_docs.append(doc)
            
            if filtered_docs:
                logger.info(f"Filtered to {len(filtered_docs)} documents for period '{extracted_period}' (from {len(docs)} docs)")
                docs = filtered_docs
            else:
                available_periods = list(set([d.metadata.get('period', 'UNKNOWN') for d in docs[:20] if d.metadata.get('period')]))
                logger.warning(f"No documents found for period '{extracted_period}'. Available periods: {available_periods}")
                # Return informative error message instead of using wrong period data
                if available_periods:
                    return f"No data available for {extracted_period}. Available periods: {', '.join(sorted(available_periods))}. Please specify one of these periods in your query."
                else:
                    return f"No data available for {extracted_period}. Data not available."
        
        # Format documents and check size (adaptive approach)
        context = format_documents(docs) if docs else "No documents found."
        
        # Smart truncation: limit to ~20k chars per context (very conservative)
        # The integrated prompt combines multiple contexts (transcript + non-transcript + excel)
        # plus tasks, CODA data, and requirements, so we need significant headroom
        # Target: 3 contexts x 20k = 60k total (safe limit for content filter)
        # For Excel bulk processing, use even more aggressive limits to account for CODA data bloat
        # NOTE: Skip global truncation if per-entity truncation was already applied
        MAX_CONTEXT_LENGTH = 15000 if is_excel_prompt_mode() else 30000  # More aggressive for Excel mode (10K instead of 12K)
        
        if per_entity_truncation_applied:
            # Per-bank or per-file truncation already applied, skip global truncation
            logger.info(f"Per-entity truncation already applied. Final context: {len(context)} chars from {len(docs)} documents")
        elif len(context) > MAX_CONTEXT_LENGTH:
            logger.warning(f"Context length {len(context)} exceeds limit {MAX_CONTEXT_LENGTH}, reducing documents")
            # Binary search for optimal document count
            left, right = 1, len(docs)
            optimal_docs = docs
            while left <= right:
                mid = (left + right) // 2
                test_context = format_documents(docs[:mid])
                if len(test_context) <= MAX_CONTEXT_LENGTH:
                    optimal_docs = docs[:mid]
                    left = mid + 1
                else:
                    right = mid - 1
            context = format_documents(optimal_docs)
            logger.info(f"Reduced from {len(docs)} to {len(optimal_docs)} documents (final length: {len(context)} chars)")
            if len(context) > MAX_CONTEXT_LENGTH:
                # Final safety truncate if still too large
                logger.warning(f"Still over limit after reduction, hard truncating to {MAX_CONTEXT_LENGTH}")
                context = context[:MAX_CONTEXT_LENGTH] + "\n\n[Context truncated due to length...]"
        else:
            logger.info(f"Context size OK: {len(context)} chars from {len(docs)} documents")
        
        logger.debug(f"Fetched context for query '{query}...': {context}... (length: {len(context)})")
        # logger.info(f"Fetched context for query '{query[:50]}...': {context[:100]}... (length: {len(context)})")
        return context
    except Exception as e:
        logger.info(f"Retrieval failed: {str(e)}")
        return f"Error: {str(e)}"

def _normalize_topics_output(raw: str) -> str:
    """Force LLM topics output into strict <ol><li>...</li></ol> HTML."""
    if not raw:
        return "<ol><li>Topic: None, Weight: 100%, Keywords: none</li></ol>"
    raw = raw.strip()
    raw = re.sub(r'^```(?:html|text)?\s*|\s*```$', '', raw, flags=re.DOTALL).strip()

    # If already well-formed
    if re.match(r'^<ol>\s*<li>.*?</li>\s*</ol>$', raw, re.DOTALL):
        return raw

    # Collect <li> blocks or build from lines
    items = re.findall(r'<li>.*?</li>', raw, re.DOTALL)
    if not items:
        items = []
        for line in raw.splitlines():
            line = line.strip()
            if not line:
                continue
            m = re.match(r'^(?:\d+\.)\s*(.+)', line) or re.match(r'^[-*]\s*(.+)', line)
            if m:
                items.append(f"<li>{m.group(1).strip()}</li>")

    if not items:
        return "<ol><li>Topic: None, Weight: 100%, Keywords: none</li></ol>"

    normalized = []
    for li in items[:5]:
        content = re.sub(r'</?li>', '', li).strip()
        topic = re.search(r'Topic:\s*([^,]+)', content, re.I)
        weight = re.search(r'Weight:\s*([\d\.]+%?)', content, re.I)
        keywords = re.search(r'Keywords?:\s*([^,][^|]+)', content, re.I)
        t = topic.group(1).strip() if topic else content[:60]
        w = weight.group(1).strip() if weight else "N/A"
        k = keywords.group(1).strip() if keywords else "N/A"
        normalized.append(f"Topic: {t}, Weight: {w}, Keywords: {k}")

    # Rebalance % if integers present
    weights = []
    for n in normalized:
        m = re.search(r'Weight:\s*(\d+)%', n)
        weights.append(int(m.group(1)) if m else None)
    if any(w is not None for w in weights):
        valid = [w for w in weights if w is not None]
        total = sum(valid)
        if total and total != 100:
            scaled = [round((w / total) * 100) if w is not None else 0 for w in weights]
            # Adjust rounding drift
            drift = 100 - sum(scaled)
            if drift != 0:
                for i, v in enumerate(scaled):
                    if v + drift >= 0:
                        scaled[i] = v + drift
                        break
            for i, val in enumerate(scaled):
                normalized[i] = re.sub(r'Weight:\s*[\dN\.A]+%?', f"Weight: {val}%", normalized[i])
        else:
            # Fill missing with equal split
            missing = [i for i, w in enumerate(weights) if w is None]
            if missing:
                per = round(100 / len(normalized))
                for i in missing:
                    normalized[i] = re.sub(r'Weight:\s*[\w\.%]+', f"Weight: {per}%", normalized[i])

    return "<ol>" + "".join(f"<li>{n}</li>" for n in normalized) + "</ol>"

