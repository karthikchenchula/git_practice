def job_attach_artifact(conn, job_id: str, *, html_text: str,
                        filename: str, output_file: str) -> None:
    """
    Save original HTML bytes (+ OUTPUT_FILE) in artifacts; update jobs row.
    """
    raw: bytes = html_text.encode("utf-8")
    sha = hashlib.sha256(raw).hexdigest()
    cursor = None
    try:
        cursor = conn.cursor()
        # upsert
        cursor.execute("DELETE FROM GENAI_EARNINGS_JOB_ARTIFACTS WHERE JOB_ID = ?", (job_id,))
        cursor.execute("""
            INSERT INTO GENAI_EARNINGS_JOB_ARTIFACTS
                (JOB_ID, CONTENT, SIZE_BYTES, SHA256, CREATED_AT, OUTPUT_FILE)
            VALUES (?,     ?,       ?,          ?,      ?,          ?)
        """, (job_id, raw, len(raw), sha, _utcnow_naive(), output_file))
        # update job metadata
        cursor.execute("""
            UPDATE GENAI_EARNINGS_JOBS
               SET UPDATED_AT = ?, FILENAME = ?, MIME_TYPE = ?
             WHERE JOB_ID = ?
        """, (_utcnow_naive(), filename, "text/html", job_id))
        conn.commit()
    except Exception:
        logger.exception("job_attach_artifact failed for %s", job_id)
        raise
    finally:
        try:
            if cursor is not None:
                cursor.close()
        except Exception:
            pass


