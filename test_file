def _job_id() -> str:
    return uuid.uuid4().hex[:12]

def _count_prompt_rows(xlsx_path: str) -> int:
    """Count non-empty rows in the 'Prompt' column (case/space-insensitive)."""
    df = pd.read_excel(xlsx_path)
    # Find the 'Prompt' column robustly
    prompt_col = next((c for c in df.columns if str(c).strip().lower() == "prompt"), None)
    if prompt_col is None:
        return 0
    series = df[prompt_col]
    # Count cells that are not NaN and not just whitespace
    count = series.astype(str).str.strip().replace({"nan": ""}).ne("").sum()
    return int(count)

def _process_excel_in_background(xlsx_path: str, job_id: str):
    token = enable_excel_prompt_mode()
    start_ts = time.monotonic()
    total = None
    try:
        # 1) mark running and set totals
        mapper_records = fetch_mapper_records()
        # logger.info(f"=== mapper_records is {mapper_records}")
        prompts = map_prompts_with_bank_metrics(xlsx_path, mapper_records)
        logger.info(f"=== prompts is {prompts}")
        # prompts = extract_prompts_with_section_from_excel(xlsx_path)
        total = len(prompts)
        conn = get_db_connection()
        try:
            job_update_status(conn, job_id, status="running", total=total, processed=0)
        finally:
            conn.close()

        def _progress(i, n):
            if i == n or i % 3 == 0:
                c = get_db_connection()
                try:
                    job_update_status(c, job_id, status="running", processed=i, total=n)
                finally:
                    c.close()

        # 2) run the prompts through your pipeline
        results = run_prompts_with_process_query(
            prompts,
            transcript_store=transcript_store,
            non_transcript_store=non_transcript_store,
            excel_non_transcript_store=excel_non_transcript_store,
            progress_cb=_progress,
            continue_on_error=True
        )

        # 3) group results by section and build HTML
        section_results = {}
        for item in results:
            section = item.get("section", "")
            res = item.get("result")
            section_key = section.strip() if section.strip() else "Prompt Results"
            if section_key not in section_results:
                section_results[section_key] = []
            section_results[section_key].append(res)

        bank, period = _extract_bank_period_for_filename(xlsx_path)

        # List your header images (static paths or URLs)
        logo1 = f"{LOCALPATH}/LogoImage/Logo1.png"
        logo2 = f"{LOCALPATH}/LogoImage/Logo2.png"

        with open(logo1, "rb") as f:
            logo1Content = base64.b64encode(f.read()).decode("utf-8")
            logo1Src = f"data:image/png;base64,{logo1Content}"
        
        with open(logo2, "rb") as f:
            logo2Content = base64.b64encode(f.read()).decode("utf-8")
            logo2Src = f"data:image/png;base64,{logo2Content}"
        header_images = [
            logo1Src,
            logo2Src
        ]

        html_parts = []

        # 1. Add header images at the top
        for img_url in header_images:
            html_parts.append(f'<img src="{img_url}" alt="Header Image" style="width:100%;display:block;margin-bottom:10px;">')

        # 2. Add bank and period info
        html_parts.append(f"<h1>{bank} - {period}</h1>")

        # 3. Add section outputs
        for section, items in section_results.items():
            if items:
                html_parts.append(f"<h2>{section}</h2>")
                for resp in items:
                    html_parts.append(f"{resp}")

        if not html_parts:
            html_parts.append("<p>No results found for any section.</p>")

        combined_html = "\n".join(html_parts)

        # 4) derive OUTPUT_FILE (Bank_Period_JobId.html)
        output_file = derive_output_file_from_excel(xlsx_path, job_id)

        # 5) store artifact in HANA and mark completed
        conn = get_db_connection()
        try:
            rec = job_get(conn, job_id)  # to reuse planned browser filename
            planned_filename = (rec or {}).get("FILENAME") or f"{job_id}.html"
            job_attach_artifact(
                conn,
                job_id,
                html_text=combined_html,
                filename=planned_filename,   # browser download name
                output_file=output_file      # DB lookup key
            )
            job_update_status(conn, job_id, status="completed", processed=total)
        finally:
            conn.close()

    except Exception as e:
        logger.exception("Background Excel processing failed.")
        conn = get_db_connection()
        try:
            job_update_status(conn, job_id, status="failed", error_text=str(e))
        finally:
            conn.close()
    finally:
        elapsed = time.monotonic() - start_ts
        logger.info(f"Excel processing finished in {_fmt_duration(elapsed)} "
                    f"(job_id={job_id}, prompts={total if total is not None else 'n/a'})")
        reset_excel_prompt_mode(token)

        # Delete the uploaded file from ChatDocuments
        try:
            if os.path.exists(xlsx_path):
                os.remove(xlsx_path)
                logger.info(f"Deleted uploaded file: {xlsx_path}")
        except Exception as e:
            logger.warning(f"Failed to delete uploaded file {xlsx_path}: {e}")


