from logger_setup import get_logger
from typing import Tuple, List, Optional
import re
from datetime import datetime

logger = get_logger()

def format_documents(docs):
    """Format retrieved documents into a single string with metadata."""
    logger.info(f"Formatting {len(docs)} documents")
    formatted = "\n\n".join(
        f"The following content is extracted from Source: {doc.metadata.get('source_file', 'Unknown')} and Page: {doc.metadata.get('page', 'Unknown')}):\n{doc.page_content})"
        for doc in docs
    )
    logger.debug(f"Documents formatted, total length: {len(formatted)} characters")

    return formatted


def normalize_quarters(query: str) -> Tuple[str, List[int]]:
    """
    Normalize quarter-year expressions like 'Q12222' or 'Q1 22' into 'Q1 2022'.
    Also return a list of suspicious (future) years if any are found.
    """
    suspicious_years = []

    def replacer(match):
        q = match.group(1).upper()
        y = match.group(2)
        try:
            year = int(y)
            # if year < 100:
            #     year += 2000
            # if year > datetime.now().year + 1:
            # Only allow 4-digit years in a valid range (e.g., 2010 to current year + 1)
            current_year = datetime.now().year
            if len(y) == 2:
                year += 2000
            if year < 2010 or year > current_year + 1:
                logger.warning(f"Suspicious year detected: {year} in '{match.group(0)}'")
                suspicious_years.append(year)
                return match.group(0)  # Don't normalize, just record
            return f"{q} {year}"
        except Exception as e:
            logger.warning(f"Failed to normalize '{match.group(0)}': {e}")
            return match.group(0)

    # query = re.sub(r"(Q[1-4])([0-9]{2,4})", replacer, query, flags=re.IGNORECASE)
    # query = re.sub(r"\b(Q[1-4])\s+([0-9]{2,4})\b", replacer, query, flags=re.IGNORECASE)
    # return query, suspicious_years
        # Step 1: Convert 1Q -> Q1 format for consistency
    query = re.sub(r"\b([1-4])Q\s*([0-9]{2,})\b", lambda m: f"Q{m.group(1)} {m.group(2)}", query, flags=re.IGNORECASE)
    query = re.sub(r"\b([1-4])Q([0-9]{2,})\b", lambda m: f"Q{m.group(1)} {m.group(2)}", query, flags=re.IGNORECASE)

    # Step 2: Normalize Q1-style quarters
    query = re.sub(r"\b(Q[1-4])\s*([0-9]{2,})\b", replacer, query, flags=re.IGNORECASE)

    return query, suspicious_years


def parse_query(query: str) -> Tuple[str, List[str], List[int]]:
    """Identify analysis types and clean the query."""
    logger.info(f"Parsing analysis request: '{query}'")
    normalized_query, suspicious_years = normalize_quarters(query)
    query_lower = normalized_query.lower()

    analysis_terms = {
        "general": ["summarize", "summary", "summarization"],
        "financial": ["finance", "financial", "revenue", "profit", "earnings", "income",
                      "balance sheet", "impairments", "highlights"],
        "trend": ["trend", "trends", "growth", "decline", "change over time", "outlook"],
        "topics": ["topics", "themes", "breakdown", "categorize", "categorization",
                   "topic breakdown", "topic analysis"],
        "quotes": ["quote", "quotes", "statement", "statements"],
        "callouts": ["callouts", "major callouts"],
        "consensus": ["consensus"],
        "stock": ["stock", "share price analysis"]
    }

    detected_types = []
    for analysis_type, terms in analysis_terms.items():
        for term in terms:
            if term in query_lower:
                if analysis_type not in detected_types:
                    detected_types.append(analysis_type)

    if not detected_types:
        logger.info("No specific analysis type detected, defaulting to 'general'")
        detected_types = ["general"]

    # ✅ Do not strip keywords; just clean spaces
    cleaned_query = re.sub(r"\s+", " ", normalized_query).strip()

    logger.info(f"Detected analysis types: {detected_types}, cleaned query='{cleaned_query}'")
    logger.debug(f"Normalized query for analysis: '{query}' → '{cleaned_query}'")
    return cleaned_query, detected_types, suspicious_years


def extract_bank_code_from_query(query: str) -> Optional[tuple]:
    """
    Extract bank code from query string using dynamic OData bank details from HANA.
    Handles formats like:
    - "bank: Citi, Period: Q4 2025, Prompt: RWA Analysis"
    - "Bank: JPMC, ..."
    - "Citi Q4 2025 revenue analysis"
    
    Returns tuple (bank_code, bank_name) or None if not found.
    Example: ('C', 'Citi') for Citigroup
    """
    logger.info(f"Extracting bank code from query: '{query}'")
    
    # Import here to avoid circular dependency
    from api_client import fetch_bank_details_from_odata
    
    # Fetch bank details dynamically from HANA via OData
    known_banks = fetch_bank_details_from_odata()
    if not known_banks:
        logger.warning("Failed to fetch bank details from OData - no banks available")
        return None
    
    bank_code = None
    bank_name = None
    
    # Normalize synonyms (these may not be in the database)
    BANK_CODE_SYNONYMS = {
        "CITI": "C",
        "CITIGROUP": "C",
        "CITI_GROUP": "C",
        "CITIGRP": "C",
    }
    
    # Try structured format first: "bank: <name>" or "Bank: <name>"
    bank_match = re.search(r'[Bb]an[k]?:\s*([^\n,]+)', query)
    
    if bank_match:
        bank_name_input = bank_match.group(1).strip().upper()
        logger.debug(f"Found bank name in structured format: '{bank_name_input}'")
        
        # Apply synonyms
        bank_name_input = BANK_CODE_SYNONYMS.get(bank_name_input, bank_name_input)
        
        # Try exact match with bank codes
        if bank_name_input in known_banks:
            bank_code = bank_name_input
            bank_name = known_banks[bank_code]
        else:
            # Try to match with bank full names
            for code, full_name in known_banks.items():
                if bank_name_input == full_name.upper() or bank_name_input in full_name.upper():
                    bank_code = code
                    bank_name = full_name
                    break
    
    # Fallback: Search for bank names or codes anywhere in the query
    if not bank_code:
        query_upper = query.upper()
        
        # First check for exact bank codes
        for code in known_banks.keys():
            if re.search(rf'\b{re.escape(code)}\b', query_upper):
                bank_code = code
                bank_name = known_banks[code]
                break
        
        # Then check for bank full names
        if not bank_code:
            for code, full_name in known_banks.items():
                if re.search(rf'\b{re.escape(full_name.upper())}\b', query_upper):
                    bank_code = code
                    bank_name = full_name
                    break
        
        # Check synonyms
        if not bank_code:
            for synonym, code in BANK_CODE_SYNONYMS.items():
                if re.search(rf'\b{re.escape(synonym)}\b', query_upper):
                    bank_code = code
                    bank_name = known_banks.get(code, code)
                    break
    
    if bank_code and bank_name:
        logger.info(f"Extracted bank code: '{bank_code}' (name: '{bank_name}') from query")
        result = (bank_code, bank_name)
        print(f"[extract_bank_code_from_query] Result: {result}")
        return (result)
    else:
        logger.info("No bank code found in query")
        print(f"[extract_bank_code_from_query] RESULT: None - No bank found in query: '{query[:100]}'")
        return None


def extract_all_banks_from_query(query: str) -> List[tuple]:
    """
    Extract ALL bank codes from query for multi-bank comparisons.
    Returns list of tuples [(bank_code1, bank_name1), (bank_code2, bank_name2), ...]
    
    Example:
        "Compare JPMC, Citi, HSBC Q4 2024" -> [('JPMC', 'JPMorgan Chase'), ('C', 'Citi'), ('HSBC', 'HSBC')]
    """
    from api_client import fetch_bank_details_from_odata
    
    print(f"[extract_all_banks_from_query] INPUT QUERY: '{query}'")
    
    known_banks = fetch_bank_details_from_odata()
    if not known_banks:
        logger.warning("Failed to fetch bank details from OData - no banks available")
        print(f"[extract_all_banks_from_query] ERROR: No banks available from OData")
        return []
    
    print(f"[extract_all_banks_from_query] Available banks from OData: {len(known_banks)} banks")
    print(f"[extract_all_banks_from_query] Bank mapping sample: {list(known_banks.items())[:5]}")
    
    found_banks = []
    query_upper = query.upper()
    
    # Normalize synonyms
    BANK_CODE_SYNONYMS = {
        "CITI": "C",
        "CITIGROUP": "C",
        "CITI_GROUP": "C",
        "CITIGRP": "C",
    }
    
    # Priority 1: Search for bank full names first (more reliable than short codes)
    for code, full_name in known_banks.items():
        full_name_upper = full_name.upper()
        pattern = rf'\b{re.escape(full_name_upper)}\b'
        if re.search(pattern, query_upper):
            if (code, full_name) not in found_banks:
                found_banks.append((code, full_name))
                logger.debug(f"Found bank by name: {full_name} ({code})")
                print(f"[extract_all_banks_from_query] ✓ MATCHED by full name: '{full_name}' -> Code: '{code}'")
    
    # Priority 2: Search for bank codes (with word boundaries)
    # For short codes (1-2 chars), only match if NOT already found by name
    for code in known_banks.keys():
        is_short_code = len(code) <= 2
        
        # Skip if already found by full name (avoids duplicate entries)
        if any(b[0] == code for b in found_banks):
            continue
        
        code_upper = code.upper()
        pattern = rf'\b{re.escape(code_upper)}\b'
        if re.search(pattern, query_upper):
            # For short codes in queries, still match but with a warning
            if is_short_code:
                logger.info(f"Matched short bank code '{code}' in query text (consider using full name '{known_banks[code]}')")
                print(f"[extract_all_banks_from_query] ⚠ MATCHED by short code: '{code}' -> Name: '{known_banks[code]}'")
            else:
                print(f"[extract_all_banks_from_query] ✓ MATCHED by code: '{code}' -> Name: '{known_banks[code]}'")
            
            if (code, known_banks[code]) not in found_banks:
                found_banks.append((code, known_banks[code]))
                logger.debug(f"Found bank by code: {code} ({known_banks[code]})")
    
    # Priority 3: Check synonyms
    for synonym, code in BANK_CODE_SYNONYMS.items():
        pattern = rf'\b{re.escape(synonym)}\b'
        if re.search(pattern, query_upper):
            if code in known_banks:
                # Skip if already found
                if any(b[0] == code for b in found_banks):
                    continue
                
                if (code, known_banks[code]) not in found_banks:
                    found_banks.append((code, known_banks[code]))
                    logger.debug(f"Found bank by synonym: {synonym} -> {code} ({known_banks[code]})")
                    print(f"[extract_all_banks_from_query] ✓ MATCHED by synonym: '{synonym}' -> Code: '{code}', Name: '{known_banks[code]}'")
    
    if found_banks:
        logger.info(f"Extracted {len(found_banks)} banks from query: {[f'{code}({name})' for code, name in found_banks]}")
        print(f"[extract_all_banks_from_query] RESULT: Found {len(found_banks)} banks: {found_banks}")
    else:
        logger.info("No banks found in query")
        print(f"[extract_all_banks_from_query] RESULT: No banks found in query: '{query[:100]}'")
    
    return found_banks

