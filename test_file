@app.route('/api/job/<job_id>/download', methods=['GET'])
@require_auth
def job_download(job_id):
    conn = get_db_connection()
    try:
        rec = job_get(conn, job_id)
        if not rec:
            return jsonify({"error": "Job not found"}), 404
        if rec["STATUS"] != "completed":
            return jsonify({"error": "Job not completed"}), 409
        art = job_fetch_artifact(conn, job_id)
    finally:
        conn.close()

    if not art:
        return jsonify({"error": "Artifact not found"}), 404

    format_req = (request.args.get("format") or "").lower()  # e.g. docx
    inline = str(request.args.get("inline", "0")).lower() in {"1", "true", "yes"}

    original_html = art["content"]
    if not isinstance(original_html, (bytes, bytearray, memoryview)):
        original_html = bytes(original_html)
    if isinstance(original_html, (bytearray, memoryview)):
        original_html = bytes(original_html)

    if format_req == "docx":
        logger.info(f"DOCX download requested for job {job_id}")
        if html2docx is None:
            logger.warning("html2docx not installed; returning 500")
            return jsonify({"error": "html2docx not installed. Run: pip install html2docx"}), 500
        try:
            html_text = original_html.decode("utf-8", errors="ignore")
            # html_text = _inline_images_for_docx(html_text)  # embed images
            buffer = BytesIO()
            generated = html2docx(html_text, title=f"Generated - Standard Report")  # May return a Document OR raw bytes
            # Distinguish return type
            if hasattr(generated, "save"):
                logger.info("html2docx returned a Document object; saving to buffer")
                generated.save(buffer)
            elif isinstance(generated, (bytes, bytearray)):
                logger.info("html2docx returned raw bytes; writing directly")
                buffer.write(generated if isinstance(generated, bytes) else bytes(generated))
            elif hasattr(generated, "getvalue"):
                logger.info("html2docx returned BytesIO; resding its contents")
                buffer.write(generated.getvalue())
            # else:
            #     logger.warning(f"Unexpected html2docx return type: {type(generated)}; attempting fallback via .save if possible")
            #     if hasattr(generated, "save"):
            #         generated.save(buffer)
            else:
                raise RuntimeError(f"Unsupported html2docx return type: {type(generated)}")
            buffer.seek(0)
            body = buffer.read()

            fname_base = (rec.get("FILENAME") or f"{job_id}.html").rsplit(".", 1)[0]
            fname = f"{fname_base}.docx"
            mime = "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            # Always force attachment unless inline explicitly requested
            disp = "inline" if inline else "attachment"
            cd = f"{disp}; filename*=UTF-8''{quote(fname)}; filename=\"{fname}\""
            headers = {
                "Content-Disposition": cd,
                "Content-Length": str(len(body)),
                "Cache-Control": "no-cache"
            }
            logger.info(f"Returning DOCX ({len(body)} bytes) for job {job_id}")
            return Response(body, content_type=mime, headers=headers)
        except Exception as e:
            logger.warning(f"DOCX conversion failed, falling back to HTML: {e}", exc_info=True)
            # fall through to HTML response below

    # Default: return stored HTML
    body = original_html
    fname  = rec.get("FILENAME") or f"{job_id}.html"
    mime   = (rec.get("MIME_TYPE") or "text/html").split(";")[0]
    disp   = "inline" if inline else "attachment"
    cd = f"{disp}; filename*=UTF-8''{quote(fname)}; filename=\"{fname}\""
    headers = {
        "Content-Disposition": cd,
        "ETag": art["sha256"],
        "Content-Length": str(len(body)),
    }
    return Response(body, content_type=f"{mime}; charset=utf-8", headers=headers)


def _check_multiple_column_values(value_list):
    unique_value_list = []
    for currentValue in value_list:
        if unique_value_list.count(currentValue) == 0:
            unique_value_list.append(currentValue)

    return unique_value_list

def _validate_upload_file():
    userid = request.form.get('userId')
    if not userid:
        return "Missing userId!"

    if 'file' not in request.files:
        return "No file part!"

    file = request.files['file']
    if file.filename == '':
        return "No selected file!"

    # Verify extension
    allowed_extensions = {'.xlsx', '.xls'}
    file_ext = os.path.splitext(file.filename)[1].lower()
    if file_ext not in allowed_extensions:
        return "Only Excel (.xlsx, .xls) files are allowed!"
    
    os.makedirs(chat_document_dir, exist_ok=True)
    file_path = os.path.join(chat_document_dir, file.filename)
    file.save(file_path)

    # Verify the count of sheet
    upload_excel = pd.ExcelFile(file_path)
    num_sheets = len(upload_excel.sheet_names)
    if num_sheets > 1:
        return "Only one sheet can be added in uploaded file!"

    # Verify excel format
    excel_file = pd.read_excel(file_path)
    valid_column_headers = ["Bank Code", "Bank Name", "Period", "Section Name", "Account Line/Segment", "Prompt"]
    upload_column_headers = excel_file.columns.tolist()
    invalid_column_headers = []
    for column_header in valid_column_headers:
        if upload_column_headers.count(column_header) == 0:
            invalid_column_headers.append(column_header)
    
    if len(invalid_column_headers) > 0:
        return f"Column header {invalid_column_headers} is missing from uploaded file, please ref template document!"
    
    # Verify empty file or column prompt is missing
    empty_file_flag = True
    empty_prompt_column_count = 0
    prompt_column_count = 0
    empty_section_column_count = 0
    empty_bank_code_column_count = 0
    bank_code_list = []
    empty_period_column_count = 0
    period_list = []
    for column_header in upload_column_headers:
        target_column = excel_file[column_header]
        value_count = target_column.astype(str).str.strip().replace({"nan": ""}).ne("").sum()
        empty_value_count = target_column.astype(str).str.strip().replace({"nan": ""}).eq("").sum()
        column_header_name = str(column_header).strip().lower()

        if value_count > 0:
            empty_file_flag = False

        if column_header_name == "prompt":
            empty_prompt_column_count = empty_value_count
            prompt_column_count = value_count
        
        if column_header_name == "section name":
            empty_section_column_count = empty_value_count

        if column_header_name == "bank code":
            empty_bank_code_column_count = empty_value_count
            bank_code_list = target_column.astype(str).tolist()
        
        if column_header_name == "period":
            period_list = target_column.astype(str).tolist()
            empty_period_column_count = empty_value_count

    if empty_file_flag:
        return "Uploaded excel file is empty!"

    if empty_bank_code_column_count > 0:
        return "Have empty value on column Bank Code, please check uploaded file!"
    
    if empty_period_column_count > 0:
        return "Have empty value on column Period, please check uploaded file!"

    if empty_section_column_count > 0:
        return "Have empty value on column Section Name, please check uploaded file!"
    
    if empty_prompt_column_count > 0:
        return "Have empty value on column Prompt, please check uploaded file!"

    max_prompt_count = 20
    if prompt_column_count > max_prompt_count:
        return f"Current count of promt is {prompt_column_count} in uploaded file, it should not be more than {max_prompt_count}!"
    
    unique_bank_code_list = _check_multiple_column_values(bank_code_list)
    if len(unique_bank_code_list) > 1:
        return f"Have multiple bank code {unique_bank_code_list} in uploaded file, please split into multiple files!"
    
    unique_period_list = _check_multiple_column_values(period_list)
    if len(unique_period_list) > 1:
        return f"Have multiple periods {unique_period_list} in uploaded file, please split into multiple files!"
    
    return ""

@app.route('/api/chat_upload', methods=['POST'])
@require_auth
def upload_excel_file():
    try:
        validateResult = _validate_upload_file()

        file = request.files['file']
        file_path = os.path.join(chat_document_dir, file.filename)
        userid = request.form.get('userId')

        if validateResult != "":
            # Delete the uploaded file from ChatDocuments
            try:
                if os.path.exists(file_path):
                    os.remove(file_path)
                    logger.info(f"Deleted uploaded file: {file_path}")
            except Exception as e:
                logger.warning(f"Failed to delete uploaded file {file_path}: {e}")
            
            return jsonify({"error": validateResult}), 400

        # Count & ETA
        prompt_count = _count_prompt_rows(file_path)
        est_seconds  = prompt_count * PER_PROMPT_SECONDS
        est_minutes  = ceil(est_seconds / 60)

        # IDs & URLs
        job_id   = _job_id()
        base_url = _infer_base_url(request)
        status_url   = urljoin(base_url, f"api/job/{job_id}")
        download_url = urljoin(base_url, f"api/job/{job_id}/download")

        # browser download name: "<original_stem>_<job>.html"
        stem, _ = os.path.splitext(file.filename)
        planned_filename = f"{stem}_{job_id}.html"

        # Persist "queued" in HANA
        conn = get_db_connection()
        try:
            job_insert(
                conn,
                job_id=job_id,
                status="queued",
                input_filename=file.filename,
                prompts_found=prompt_count,
                mime_type="text/html",
                filename=planned_filename,
                userid=userid  # <-- pass this from your upload endpoint
            )
        finally:
            conn.close()

        # Kick off background worker
        threading.Thread(
            target=_process_excel_in_background,
            args=(file_path, job_id),
            daemon=True
        ).start()

        return jsonify({
            "message": f"File '{file.filename}' uploaded successfully and queued for processing.",
            "job_id": job_id,
            "userId": userid,
            "status_url": status_url,
            "download_url": download_url,         # will 409 until completed
            "prompts_found": prompt_count,
            "estimated_processing_time": f"{est_minutes} minute(s)"
        }), 202

    except Exception as e:
        logger.exception("Upload failed")
        return jsonify({"error": str(e)}), 500
    

