def run_prompts_with_process_query(
    prompts: Iterable[Dict[str, Any]],
    *,
    transcript_store=None,
    non_transcript_store=None,
    excel_non_transcript_store=None,
    progress_cb: Optional[callable] = None,
    continue_on_error: bool = True
) -> List[Dict[str, Any]]:
    """
    Feeds each 'input_message' (just the Prompt) directly to your existing process_query(...)
    and returns a list of per-row results.
    """
    prompts_list = list(prompts)
    n = len(prompts_list)
    results: List[Dict[str, Any]] = []

    for i, item in enumerate(prompts_list, start=1):
        msg = item["input_message"]  # ONLY the 'Prompt' text
        try:
            result = process_query(
                msg,
                transcript_store=transcript_store,
                non_transcript_store=non_transcript_store,
                excel_non_transcript_store=(
                    excel_non_transcript_store if excel_non_transcript_store is not None else None
                )
            )
        except Exception as e:
            if not continue_on_error:
                raise
            result = {"error": str(e)}
            logger.warning(f"Prompt processing failed for row {item['row_index']}: {str(e)[:200]}")
        
        # Check if result contains specific error patterns and replace with custom message
        result_str = str(result)
        if isinstance(result, dict) and "error" in result:
            error_msg = str(result["error"])
        else:
            error_msg = result_str
        
        # Convert to lowercase for case-insensitive pattern matching
        error_msg_lower = error_msg.lower()
        
        # Replace specific error messages for Excel bulk processing with AskFinSight redirect
        # Check for various error patterns (case-insensitive)
        error_patterns = [
            "query return",  # Catches "Query return too much" or "query returned too much data"
            "being more specific",
            "add period/quarter filter",
            "breaking the query into smaller",
            "content filtered due to safety",
            "filtering module",
            "input filter",
            "error in data requirement",  # Catches both "requirement" and "requirements"
            "safety violations",
            "please modify the prompt"
        ]
        
        if any(pattern in error_msg_lower for pattern in error_patterns):
            logger.info(f"Replacing error message for row {item['row_index']} with AskFinSight redirect")
            result = "⚠️ Please re-execute this prompt using 'AskFinSight' to ensure optimal results."

        results.append({
            "row_index": item["row_index"],
            "prompt": item["prompt"],
            "input_message": msg,
            "section": item.get("section", ""),  # <-- ADD THIS LINE
            "result": result
        })

        if progress_cb:
            progress_cb(i, n)

    return results

