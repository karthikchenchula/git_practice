def _find_col(df: pd.DataFrame, name: str) -> str | None:
    key = name.strip().lower()
    for c in df.columns:
        if str(c).strip().lower() == key:
            return c
    return None

def _first_nonempty(series: pd.Series) -> str | None:
    for v in series.astype(str):
        s = (v or "").strip()
        if s and s.lower() != "nan":
            return s
    return None

def _normalize_for_key(value: str) -> str:
    """
    Light normalization for a DB/URL key (NOT filesystem):
    - collapse whitespace to underscore
    - remove slashes/backslashes and newlines
    - trim
    """
    s = re.sub(r'\s+', '_', value.strip())
    s = re.sub(r'[\\/]+', '_', s)      # no path separators
    s = s.replace('\n', '_').replace('\r', '_')
    return s or "Unknown"

def _extract_bank_period_for_filename(xlsx_path: str) -> tuple[str, str]:
    """Read Excel once and pull first non-empty Bank Code and Period (case-insensitive)."""
    df = pd.read_excel(xlsx_path)
    bank_col = _find_col(df, "Bank Code")
    period_col = _find_col(df, "Period")

    bank = _first_nonempty(df[bank_col]) if bank_col else None
    period = _first_nonempty(df[period_col]) if period_col else None

    bank = _normalize_for_key(bank or "UnknownBank")
    period = _normalize_for_key(period or "UnknownPeriod")
    return bank, period

def derive_output_file_from_excel(xlsx_path: str, job_id: str) -> str:
