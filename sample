import os
from datetime import datetime

from reportlab.lib.pagesizes import letter
from reportlab.lib import colors
from reportlab.platypus import (
    Paragraph,
    Spacer,
)
from reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle
from reportlab.lib.units import inch
from reportlab.platypus import PageTemplate, BaseDocTemplate, Frame
from reportlab.lib.enums import TA_CENTER, TA_JUSTIFY

from .models import HorizontalLine


class PDFGenerator:
    def __init__(self, filename: str, output_dir: str) -> None:
        self.filename = filename
        self.base_filename = os.path.splitext(filename)[0]
        self.output_dir = output_dir
        self.output_file = os.path.join(
            self.output_dir, f"SummHay_{self.base_filename}.pdf"
        )

    def _add_header_footer(self, canvas, doc):
        """Add header, footer, and page number to each page."""
        canvas.saveState()
        canvas.setFont("Helvetica", 9)
        page_num = canvas.getPageNumber()
        canvas.drawRightString(
            doc.width + doc.rightMargin, 0.5 * inch, f"Page {page_num}"
        )
        current_date = datetime.now().strftime("%Y-%m-%d")
        canvas.drawString(
            doc.leftMargin,
            0.5 * inch,
            f"✨ Generated by FinSight.Intelligence:{current_date}. Please review before use",
        )
        canvas.setLineWidth(0.5)
        canvas.line(
            doc.leftMargin, 0.75 * inch, doc.width + doc.rightMargin, 0.75 * inch
        )
        canvas.restoreState()

    def _get_template(self) -> BaseDocTemplate:
        document = BaseDocTemplate(
            self.output_file,
            pagesize=letter,
            rightMargin=inch,
            leftMargin=inch,
            topMargin=1.2 * inch,
            bottomMargin=inch,
        )

        # Define frame and template
        frame = Frame(
            document.leftMargin,
            document.bottomMargin,
            document.width,
            document.height,
            id="normal",
        )
        template = PageTemplate(
            id="AllPages", frames=frame, onPage=self._add_header_footer
        )
        document.addPageTemplates([template])

        return document

    def _get_styles(self):
        # Define styles
        styles = getSampleStyleSheet()
        styles["Title"].fontName = "Helvetica-Bold"
        styles["Title"].fontSize = 20
        styles["Title"].leading = 24
        styles["Title"].alignment = TA_CENTER
        styles["Title"].spaceAfter = 12
        styles.add(
            ParagraphStyle(
                name="DocumentSubtitle",
                fontName="Helvetica-Oblique",
                fontSize=12,
                leading=14,
                alignment=TA_CENTER,
                spaceAfter=24,
            )
        )
        styles.add(
            ParagraphStyle(
                name="CustomHeading1",
                fontName="Helvetica-Bold",
                fontSize=16,
                leading=20,
                spaceBefore=12,
                spaceAfter=6,
            )
        )
        styles.add(
            ParagraphStyle(
                name="CustomHeading2",
                fontName="Helvetica-Bold",
                fontSize=14,
                leading=17,
                spaceBefore=8,
                spaceAfter=4,
                textColor=colors.navy,
            )
        )
        styles.add(
            ParagraphStyle(
                name="CustomBody",
                fontName="Helvetica",
                fontSize=11,
                leading=14,
                alignment=TA_JUSTIFY,
                firstLineIndent=20,
            )
        )

        return styles

    def generate(self, description: str, summary: str) -> str:
        output_md_path = os.path.join(
            self.output_dir, f"SummHay_{self.base_filename}.md"
        )

        # Create markdown content
        markdown_content = f"""---
        title: "{description} of {self.filename}"
        author: "Document Summary Service"
        date: "{datetime.now().strftime("%Y-%m-%d")}"
        ---

        # Executive SummHay Summary: {self.base_filename}

        {summary}
        """

        styles = self._get_styles()
        document = self._get_template()

        # Write markdown file
        with open(output_md_path, "w", encoding="utf-8") as f:
            f.write(markdown_content)

        # Build PDF content
        flowables = []
        title = f"{description} of {self.filename}"
        flowables.append(Paragraph(title, styles["Title"]))
        flowables.append(Spacer(1, 0.1 * inch))
        current_date = datetime.now().strftime("%B %d, %Y")
        flowables.append(
            Paragraph(
                f"✨ Generated by FinSight.Intelligence:{current_date}. Please review before use",
                styles["DocumentSubtitle"],
            )
        )
        flowables.append(HorizontalLine(document.width))
        flowables.append(Spacer(1, 0.2 * inch))

        # Process markdown content
        with open(output_md_path, "r", encoding="utf-8") as f:
            md_content = f.read()

        lines = md_content.split("\n")
        skip_frontmatter = True
        frontmatter_end = False

        for line in lines:
            if skip_frontmatter and line.strip() == "---":
                if not frontmatter_end:
                    frontmatter_end = True
                    continue
                else:
                    skip_frontmatter = False
                    continue
            if skip_frontmatter:
                continue
            line = line.strip()
            if not line:
                flowables.append(Spacer(1, 0.1 * inch))
                continue
            if line.startswith("# "):
                flowables.append(Spacer(1, 0.1 * inch))
                flowables.append(Paragraph(line[2:], styles["CustomHeading1"]))
            elif line.startswith("## "):
                flowables.append(Spacer(1, 0.1 * inch))
                flowables.append(Paragraph(line[3:], styles["CustomHeading2"]))
            else:
                flowables.append(Paragraph(line, styles["CustomBody"]))

        # Build PDF
        document.build(flowables)

        # Delete markdown file
        os.remove(output_md_path)

        return self.output_file

