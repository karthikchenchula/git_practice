        if name is None:
            raise TypeError("missing property 'name'")
        else:
            self.name = name

    # TODO: Add caching with automatic expiry on jwt token expiry
    def _generate_token(self) -> str:
        """
        Private method to generate oauth token for destination instance
        """
        creds = current_app.destination["credentials"]  # type: ignore
        logger = current_app.logger
        try:
            response = httpx.post(
                f"{creds['auth_url']}/oauth/token",
                data={"grant_type": "client_credentials"},
                auth=httpx.BasicAuth(
                    username=creds["clientid"], password=creds["clientsecret"]
                ),
                verify=current_app.settings.ssl_verify,  # type: ignore
            )
            response.raise_for_status()
            token = response.json()["access_token"]
        except Exception as e:
            logger.error(
                f"Error while generating token for destination service. \n {e}"
            )
            raise e

        return token

    def get_config(self) -> dict:
        """
        Fetch destination configuration
        """
        creds = current_app.destination["credentials"]  # type: ignore
