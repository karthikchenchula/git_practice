import os

from datetime import datetime, timezone
from typing import Any
import uuid

from flask import current_app, g
from werkzeug.exceptions import BadRequest

from .base_pipeline import BaseDublinPipeline
from util.file_util import extract_bank_code, extract_period
from db.sql import UPSERT_IMAGE, SELECT_IMAGES_FOR_VALIDATION
from db.scripts import to_list_dict


class DublinImagePipeline(BaseDublinPipeline):
    """
    Pipeline to generate Dublin metadata and store in hana for Image type files
    """

    def __init__(self, file, overwrite: bool):
        super().__init__(file, overwrite)
        self.directory = current_app.config["IMAGE_DIR"]
        self.filepath = os.path.join(self.directory, self.filename)

    def _validate_file(self, filename: str, filehash: str):
        valid = True
        exists = True
        file = None

        self.cursor.execute(
            SELECT_IMAGES_FOR_VALIDATION.format(
                schema=g.db_config["SCHEMA"], table=g.db_config["IMAGE_TABLE"]
            ),
            {"filename": filename, "file_hash": filehash},
        )

        rows_list = to_list_dict(self.cursor.fetchall())

        if len(rows_list) > 0:
            for row in rows_list:
                if row["FILE_HASH"] == filehash and row["FILENAME"] != filename:
                    valid = False
                    exists = True
                    file = row
                elif row["FILENAME"] == filename:
                    file = row

        else:
            exists = False

        return (valid, exists, file)

    def process(self) -> dict[str, Any]:
        """
        Process file by saving the file blob to Hana
        """
        success = True
        self._save_file(self.filepath)

        file_hash = self._calc_sha256(self.filepath)

        valid, exists, file = self._validate_file(self.filename, file_hash)

        if not valid:
            self._remove_file(self.filepath)
            raise BadRequest(
                f"File hash exists with file name {file.get('FILENAME', 'UNKNOWN')}"  # type: ignore
            )  # type: ignore

        if (valid and self.overwrite) or not exists:
            bank_code = extract_bank_code(self.filename, g.KNOWN_BANKS)
            period = extract_period(self.filename)

            image_bytes = self.file.read()

            if exists:
                id = file.get("ID", uuid.uuid4())  # type: ignore
            else:
                id = str(uuid.uuid4())

            try:
                self.cursor.execute(
                    UPSERT_IMAGE.format(
                        schema=g.db_config["SCHEMA"], table=g.db_config["IMAGE_TABLE"]
                    ),
                    {
                        "id": id,
                        "bank": bank_code,
                        "period": period,
                        "image_file": image_bytes,
                        "filename": self.filename,
                        "created_at": datetime.now(timezone.utc),
                        "file_hash": file_hash,
                    },
                )

                g.db.commit()
            except Exception as e:
                success = False
                self._remove_file(self.filepath)
                raise Exception(f"Error while uploading image to hana. \n Trace: {e}")

        self.cursor.close()
        self._remove_file(self.filepath)

        return {
            "filename": self.filename,
            "folder": "Images",
            "message": f"File {self.filename} upload {'successful' if success else 'failed'}.",
            "success": success,
        }
