api = Blueprint("API_Service", __name__, url_prefix="/api")


def get_known_banks():
    """
    Get Known Banks for peer-analysis from peer-analysis Odata service.
    Returns empty dict if service is unavailable - validation will handle this gracefully.
    """
    use_case = request.args.get("use_case")
    banks = {}
    
    if use_case == UseCases.PEERANALYSIS.value:
        try:
            bank_client = CAPService(current_app.settings.bank_destination).get_client()  # type: ignore

            response = bank_client.get(
                "/v2/odata/v4/earning-upload-srv/Banks?$select=name,code"
            )

            response.raise_for_status()

            result = response.json()["d"]["results"]

            for bank in result:
                banks[bank["code"]] = bank["name"]
                
            current_app.logger.info(f"Successfully fetched {len(banks)} known banks from service")
            
        except Exception as e:
            # Log warning but don't crash - return empty dict
            # Downstream validation will provide appropriate error messages to user
            current_app.logger.warning(
                f"Bank service unavailable: {str(e)}. "
                f"Bank code validation may be limited. "
                f"Service: {current_app.settings.bank_destination}"
            )
            # Return empty dict - let validation logic handle missing banks
            banks = {}

    return banks


def validate_query_param():
    """
    Validate mandatory query parameters of the request
    """
    use_case = request.args.get("use_case", None)

    if use_case is None or not UseCases.has_value(use_case):
        raise BadRequest(
            f"Request must include query parameter 'use_case' with value in {UseCases.to_list()}"
        )


def validate_files():
    if request.path == "/api/upload":
        use_case = request.args.get("use_case")
        if request.files.get("file") is None:
            raise BadRequest("files is a mandantory parameter")
        else:
            filename = request.files["file"].filename
            file_ext = os.path.splitext(filename)[1].lower()  # type: ignore
            if (
                use_case == UseCases.TREASURY.value
                and not DocumentExtensions.has_value(file_ext)
            ):
                raise BadRequest(
                    f"Unsupported file type. The file must be of one of the following types {DocumentExtensions.to_list()}"
                )
            elif not ImageExtensions.has_value(
                file_ext
            ) and not DocumentExtensions.has_value(file_ext):
                raise BadRequest(
                    f"Unsupported file type. The file must be of one of the following types {ImageExtensions.to_list() + DocumentExtensions.to_list()}"
                )

            bank_code = extract_bank_code(filename, g.KNOWN_BANKS)  # type: ignore
            if use_case == UseCases.PEERANALYSIS.value and bank_code == "UNKNOWN":
                # Provide context-aware error message
                if len(g.KNOWN_BANKS) == 0:
                    raise BadRequest(
                        f"Unable to validate bank code in filename '{filename}'. "
                        f"The bank reference service is currently unavailable. "
                        f"Please try again later or contact support if the issue persists."
                    )
                else:
                    raise BadRequest(
                        f"Unable to find bank code in the filename '{filename}'. "
                        f"Please include a valid bank code and try again or check if the bank onboarding has been completed."
                    )

            period = extract_period(filename)  # type: ignore
            if use_case == UseCases.PEERANALYSIS.value and period == "UNKNOWN":
                raise BadRequest(
                    f"Unable to find period in the filename '{filename}'. Please include period and try again."
                )


@api.before_request
def api_before_middleware():
    validate_query_param()
    g.KNOWN_BANKS = get_known_banks()
    validate_files()
    init_db()


@api.teardown_request
def api_teardown_middleware(exec):
    release_db()


@api.route("/upload", methods=["POST"])
def upload_file():
    """
    API to generate Dublin core metadata
    """

    # Get Form parameters
    file = request.files["file"]
    overwrite = request.form.get("overwrite", "false").lower() == "true"

    # Get file details
    filename = file.filename
    file_ext = os.path.splitext(filename)[1].lower()  # type: ignore

    if ImageExtensions.has_value(file_ext):
        img_pipeline = DublinImagePipeline(file, overwrite)

        response_data = img_pipeline.process()
    else:
        doc_pipeline = DublinDocumentPipeline(file, overwrite)

        response_data = doc_pipeline.process()

    return jsonify(response_data)


@api.route("/generate-embeddings", methods=["POST"])
def generate_embeddings():
    doc_id = request.json.get("document_id", None)  # type: ignore
    use_case = str(request.args.get("use_case"))

    if not doc_id:
        raise BadRequest("Missing mandatory parameter 'document_id' in request body.")

    embed_pipeline = EmbeddingPipeline(doc_id, use_case)

    result = embed_pipeline.process()

    return jsonify(result)


@api.route("/delete", methods=["DELETE"])
def delete_embeddings():
    doc_id = request.json.get("document_id", None)  # type: ignore

    if not doc_id:
        raise BadRequest("Missing mandatory parameter 'document_id' in request body.")

    delete_pipeline = DeletePipeline(doc_id)

    result = delete_pipeline.delete()

    return jsonify(result)

