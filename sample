import os
import json
from typing import Any
from flask import current_app, g
from datetime import datetime, timezone
from werkzeug.exceptions import BadRequest

from .base_pipeline import BaseDublinPipeline
from dublin import SimpleDocumentProcessor
from db.scripts import to_list_dict
from db.sql import SELECT_DOCUMENT_FOR_VALIDATION, UPSERT_DUBLIN_METADATA


class DublinDocumentPipeline(BaseDublinPipeline):
    """
    Pipeline to generate Dublin metadata and store in hana for Document type files
    """

    def __init__(self, file, overwrite: bool = False):
        super().__init__(file, overwrite)
        self.directory = current_app.config["DOCUMENT_DIR"]
        self.filepath = os.path.join(self.directory, self.filename)

    def _validate_file(self, filename: str, filehash: str):
        valid = True
        exists = True
        metadata = None

        self.cursor.execute(
            SELECT_DOCUMENT_FOR_VALIDATION.format(
                schema=g.db_config["SCHEMA"], table=g.db_config["DUBLIN_TABLE"]
            ),
            {"filename": filename, "file_hash": filehash},
        )

        rows_list = to_list_dict(self.cursor.fetchall())

        if len(rows_list) > 0:
            for row in rows_list:
                if (
                    row["SHA256_HASH"] == filehash
                    and row["ORIGINAL_FILENAME"] != filename
                ):
                    valid = False
                    exists = True
                    metadata = row
                elif row["ORIGINAL_FILENAME"] == filename:
                    metadata = row
        else:
            exists = False

        return (valid, exists, metadata)

    def _preapre_upsert_data(self, metadata: dict) -> dict:
        metadata_json = metadata.get("metadata_json")  # type: ignore

        dublin_core = metadata_json.get("dublin_core", {})  # type: ignore
        file_info = metadata_json.get("file_info", {})  # type: ignore
        file_hash = file_info.get("file_hash", {})
        copyright_info = metadata_json.get("copyright_info", {})  # type: ignore
        license_info = metadata_json.get("license_info", {})  # type: ignore
        access_control = metadata_json.get("access_control", {})  # type: ignore
        extraction_metadata = metadata_json.get("extraction_metadata", {})  # type: ignore

        creator = (
            ", ".join(dublin_core.get("creator", ["Unknown"]))
            if dublin_core.get("creator")
            else "Unknown"
        )

        contributor = (
            ", ".join(dublin_core.get("contributor", []))
            if dublin_core.get("contributor")
            else ""
        )

        subject = (
            ", ".join(dublin_core.get("subject", []))
            if dublin_core.get("subject")
            else ""
        )

        confidence_scores = json.dumps(
            extraction_metadata.get("confidence_scores", {}), ensure_ascii=False
        )

        response = {
            "document_id": metadata_json.get("document_id", ""),  # type: ignore
            "filename": metadata.get("filename"),
            "file_extension": os.path.splitext(self.filename)[1].lower(),
            "file_path": file_info.get("file_path", "Documents"),
            "file_size": file_info.get("file_size", 0),
            "mime_type": file_info.get("mime_type", ""),
            "upload_timestamp": datetime.now(timezone.utc),
            "metadata_json": json.dumps(metadata_json, ensure_ascii=False),
            "title": dublin_core.get("title", "Untitled"),
            "creator": creator,
            "subject": subject,
            "description": dublin_core.get("description", ""),
            "publisher": dublin_core.get("publisher", ""),
            "contributor": contributor,
            "document_date": dublin_core.get("date", datetime.now().isoformat() + "Z"),
            "dc_type": dublin_core.get("type", "Unknown"),
            "file_format": dublin_core.get("format", "Unknown"),
            "language": dublin_core.get("language", "en-US"),
            "rights": dublin_core.get("rights", ""),
            "md5_hash": file_hash.get("md5", ""),
            "sha256_hash": file_hash.get("sha256", ""),
            "copyright_status": copyright_info.get("copyright_status", "Unknown"),
            "copyright_year": copyright_info.get("copyright_year", None),
            "copyright_holder": copyright_info.get("copyright_holder", None),
            "license_type": license_info.get("license_type", "All Rights Reserved"),
            "access_level": access_control.get("access_level", "Public"),
            "extraction_method": extraction_metadata.get("extraction_method", ""),
            "extraction_date": extraction_metadata.get("extraction_date", ""),
            "extraction_tool": extraction_metadata.get("extraction_tool", ""),
            "confidence_scores": confidence_scores,
            "audit_trail": json.dumps(metadata.get("audit_trail", [])),
            "processing_decision": metadata.get("final_decision"),
            "reasoning": metadata.get("reasoning"),
            "scb_document": metadata.get("scb_document"),
            "dc_classification": metadata.get("classification_keywords", ""),
            "dc_primary_classification": metadata.get("primary_classification", ""),
        }

        return response

    def _format_metadata(self, metadata: dict[str, Any]) -> dict[str, Any]:
        fmt_mdata = {}
        for key in metadata:
            key_sml_case = key.lower()
            if key_sml_case in ["metadata_json", "audit_trail", "confidence_scores"]:
                fmt_mdata[key_sml_case] = json.loads(metadata[key])
            else:
                fmt_mdata[key_sml_case] = metadata[key]

        return fmt_mdata

    def process(self) -> dict[str, Any]:
        """
        Process file to generate metadata and save the file blob to Hana
        """
        self._save_file(self.filepath)

        file_hash = self._calc_sha256(self.filepath)

        valid, exists, metadata = self._validate_file(self.filename, file_hash)

        if not valid:
            raise BadRequest(
                f"File hash exists with file name {metadata.get('ORIGINAL_FILENAME')}"  # type: ignore
            )

        # Initialize base message
        base_message = (
            f"File '{self.filename}' uploaded and scanning through the Document."
        )

        try:
            if (valid and self.overwrite) or not exists:
                processor = SimpleDocumentProcessor(documents_folder=self.directory)
                result = processor.process_document(self.filename)  # type: ignore

                if exists:
                    result["metadata_json"]["document_id"] = metadata.get("DOCUMENT_ID")  # type: ignore

                data = self._preapre_upsert_data(result)

                self.cursor.execute(
                    UPSERT_DUBLIN_METADATA.format(
                        schema=g.db_config["SCHEMA"], table=g.db_config["DUBLIN_TABLE"]
                    ),
                    data,
                )

                g.db.commit()

                if result["status"] == "SUCCESS":
                    # Enhanced success message with decision
                    decision = result.get("final_decision", "Unknown")
                    final_message = f"{base_message} and processed. Decision: {decision}.Reasoning: {result['reasoning']}"
                else:
                    # File uploaded but processing failed
                    final_message = f"{base_message}, but processing failed"
            else:
                data = metadata
                decision = data.get("PROCESSING_DECISION", "Unknown")  # type: ignore
                final_message = f"{base_message} and processed. Decision: {decision}.Reasoning: {data['REASONING']}"  # type: ignore

            response = self._format_metadata(data)  # type: ignore

            return {
                "filename": self.filename,
                "folder": "Documents",
                "message": final_message,
                "success": True,
                "metadata": response,
            }
        except Exception as e:
            raise e
        finally:
            self.cursor.close()
            self._remove_file(self.filepath)

