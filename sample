        """Check if content contains a markdown table."""
        lines = content.split("\n")
        table_rows = [l for l in lines if self.PATTERNS["table_row"].match(l.strip())]
        return len(table_rows) >= 2  # At least header and one data row

    def _parse_table_structure(self, section: ParsedSection) -> None:
        """
        Parse table structure from section content.
        Extracts title, header row, separator, and data rows.
        """
        # Clean the content first to remove old markers
        cleaned_content = self._clean_content_for_chunk(section.raw_content)
        lines = cleaned_content.split("\n")

        # Find table title (## heading before table)
        title_lines = []
        table_header = None
        table_separator = None
        table_rows = []
        in_table = False

        for line in lines:
            stripped = line.strip()

            # Check for table row
            if self.PATTERNS["table_row"].match(stripped):
                if not in_table:
                    # First table row is the header
                    in_table = True
                    table_header = stripped
                elif self.PATTERNS["table_separator"].match(stripped):
                    # Separator row
                    table_separator = stripped
                else:
                    # Data row
                    table_rows.append(stripped)
            elif in_table and not stripped:
                # Empty line might end table, but continue checking
                continue
            elif not in_table and stripped.startswith("##"):
                # Table title
                title_lines.append(stripped)

        section.table_title = "\n".join(title_lines) if title_lines else None
        section.table_header = table_header
        section.table_separator = table_separator
        section.table_rows = table_rows

    def _parse_section(self, raw_content: str) -> ParsedSection:
        """
        Parse a raw section and extract all metadata and content.

        Args:
            raw_content: Raw section content

        Returns:
            ParsedSection with all metadata extracted
        """
        metadata = ChunkMetadata()

        # Extract page-level markers
        page_start_match = self.PATTERNS["page_start"].search(raw_content)
        if page_start_match:
            metadata.page_start = page_start_match.group(1).strip()
            # Parse page numbers from page_start string
            metadata.page, metadata.total_pages = self._parse_page_numbers(metadata.page_start)

        page_header_match = self.PATTERNS["page_header"].search(raw_content)
        if page_header_match:
            metadata.page_header = page_header_match.group(1).strip()

        # Extract section-level markers
        section_id_match = self.PATTERNS["section_id"].search(raw_content)
        if section_id_match:
            metadata.section_id = section_id_match.group(1).strip()

        section_type_match = self.PATTERNS["section_type"].search(raw_content)
        if section_type_match:
            metadata.section_type = section_type_match.group(1).strip()

        hierarchy_match = self.PATTERNS["hierarchy"].search(raw_content)
        if hierarchy_match:
            metadata.hierarchy = hierarchy_match.group(1).strip()

        # Check for existing section context in TABLE_STRUCTURE
        table_structure_match = self.PATTERNS["table_structure"].search(raw_content)
        if table_structure_match:
            context_match = self.PATTERNS["section_context"].search(
                table_structure_match.group(1)
            )
            if context_match:
                metadata.section_context = context_match.group(1).strip()

        # Detect if atomic section
        is_atomic = bool(self.PATTERNS["atomic_start"].search(raw_content))

        # Determine content type
        if is_atomic:
            content_type = "ATOMIC"
        elif metadata.section_type in ("LONG_TABLE", "SIMPLE_TABLE"):
            content_type = "TABLE"
        elif self._contains_table(raw_content):
            content_type = "TABLE"
        else:
            content_type = "TEXT"

        # Create parsed section
        section = ParsedSection(
            raw_content=raw_content,
            content_type=content_type,
            metadata=metadata,
            is_atomic=is_atomic,
        )

        # Parse table structure if applicable
        if content_type == "TABLE":
            self._parse_table_structure(section)

        # Extract footnotes
        footnotes_match = self.PATTERNS["footnotes"].search(raw_content)
        if footnotes_match:
            section.footnotes = footnotes_match.group(0).strip()

        # Calculate token count
        section.token_count = self.count_tokens(raw_content)

        return section

    def _clean_content_for_chunk(self, content: str) -> str:
        """
        Clean content by removing old markers that will be replaced.

        Args:
            content: Raw content

        Returns:
            Cleaned content
        """
        # Remove page-level markers (we'll add fresh ones)
        content = self.PATTERNS["page_start"].sub("", content)
        content = self.PATTERNS["page_header"].sub("", content)
        content = self.PATTERNS["page_end"].sub("", content)

        # Remove section-level markers
        content = self.PATTERNS["section_id"].sub("", content)
        content = self.PATTERNS["section_type"].sub("", content)
        content = self.PATTERNS["section_context_re"].sub("", content)
        content = self.PATTERNS["hierarchy"].sub("", content)
        content = self.PATTERNS["table_structure"].sub("", content)

        # Remove atomic markers
        content = self.PATTERNS["atomic_start"].sub("", content)
        content = self.PATTERNS["atomic_end"].sub("", content)

        # Remove page analysis block
        content = re.sub(
            r"<!--\s*PAGE_ANALYSIS.*?-->", "", content, flags=re.DOTALL | re.IGNORECASE
        )

        # Remove related sections marker
        content = re.sub(
            r"<!--\s*RELATED_SECTIONS:.*?-->", "", content, flags=re.IGNORECASE
        )

        # Clean up excessive whitespace
        content = re.sub(r"\n{3,}", "\n\n", content)
        content = content.strip()

        return content

    def _clean_chunk_headers(self, content: str) -> str:
        """
        Clean content by removing old markers that will be replaced.

        Args:
            content: Raw content

        Returns:
            Cleaned content
        """
        # Remove page-level markers (we'll add fresh ones)
        content = self.PATTERNS["page_start"].sub("", content)
        # content = self.PATTERNS["page_header"].sub("", content)
        content = self.PATTERNS["page_end"].sub("", content)

        # Remove section-level markers
        # content = self.PATTERNS["section_id"].sub("", content)
        content = self.PATTERNS["section_type"].sub("", content)
        content = self.PATTERNS["section_context_re"].sub("", content)
        # content = self.PATTERNS["hierarchy"].sub("", content)
        content = self.PATTERNS["table_structure"].sub("", content)

        # Remove atomic markers
        content = self.PATTERNS["atomic_start"].sub("", content)
        content = self.PATTERNS["atomic_end"].sub("", content)

        # Remove page analysis block
        content = re.sub(
            r"<!--\s*PAGE_ANALYSIS.*?-->", "", content, flags=re.DOTALL | re.IGNORECASE
        )

        # Remove related sections marker
        content = re.sub(
            r"<!--\s*RELATED_SECTIONS:.*?-->", "", content, flags=re.IGNORECASE
        )

        # Clean up excessive whitespace
        content = re.sub(r"\n{3,}", "\n\n", content)
        content = content.strip()

        return content

    def _process_atomic_section(self, section: ParsedSection) -> List[Document]:
        """
        Process an atomic section - keep together regardless of size.

        Args:
            section: Parsed atomic section

        Returns:
            List containing single OutputChunk
        """
        metadata = ChunkMetadata(
            page_start=section.metadata.page_start,
            page_header=section.metadata.page_header,
            hierarchy=section.metadata.hierarchy,
            section_context="ATOMIC",
            section_type=section.metadata.section_type,
            section_id=section.metadata.section_id,
            page=section.metadata.page,
            total_pages=section.metadata.total_pages,
        )

        # Clean content (remove old markers, we'll add new ones)
        content = self._clean_content_for_chunk(section.raw_content)

        # Add metadata header to content
        header = metadata.to_header()
        if header:
            content = f"{header}\n\n{content}"

        content = self._clean_chunk_headers(section.raw_content)

        chunk = Document(page_content=content, metadata=metadata.to_dict())

        return [chunk]

    def _group_items(
        self, items: List[str], max_tokens: int, prefix: str = ""
    ) -> List[str]:
        """
        Group items (bullets, sentences) into chunks.

        Args:
            items: List of items to group
            max_tokens: Maximum tokens per chunk
            prefix: Prefix to add to each item (e.g., '• ')

        Returns:
            List of grouped chunks
        """
        chunks = []
        current = []
        current_tokens = 0

        for item in items:
            if not item.strip():
                continue

            item_text = f"{prefix}{item.strip()}" if prefix else item.strip()
            item_tokens = self.count_tokens(item_text)

            if current_tokens + item_tokens <= max_tokens:
                current.append(item_text)
                current_tokens += item_tokens
            else:
                if current:
                    chunks.append("\n".join(current))
                current = [item_text]
                current_tokens = item_tokens

        if current:
            chunks.append("\n".join(current))

        return chunks if chunks else ["\n".join(items)]

    def _split_large_paragraph(self, para: str, max_tokens: int) -> List[str]:
        """
        Split a large paragraph by bullets or sentences.

        Args:
            para: Paragraph text
            max_tokens: Maximum tokens per chunk

        Returns:
            List of text chunks
        """
        # Try splitting by bullet points
        bullet_pattern = re.compile(r"^[\s]*[•\-\*]\s+", re.MULTILINE)
        bullets = bullet_pattern.split(para)

        if len(bullets) > 1:
            # Has bullets - group them
            return self._group_items(bullets, max_tokens, prefix="• ")

        # No bullets - split by sentences
        sentences = re.split(r"(?<=[.!?])\s+", para)
        return self._group_items(sentences, max_tokens)

    def _split_text_by_boundaries(self, content: str, max_tokens: int) -> List[str]:
        """
        Split text at natural boundaries (paragraphs, bullets, sentences).

        Args:
            content: Text content to split
            max_tokens: Maximum tokens per chunk

        Returns:
            List of text chunks
        """
        # Try splitting by double newlines (paragraphs)
        paragraphs = re.split(r"\n\n+", content)

        chunks = []
        current_chunk = []
        current_tokens = 0

        for para in paragraphs:
            para_tokens = self.count_tokens(para)

            if current_tokens + para_tokens <= max_tokens:
                current_chunk.append(para)
                current_tokens += para_tokens
            else:
                # Save current chunk if not empty
                if current_chunk:
                    chunks.append("\n\n".join(current_chunk))

                # Handle paragraph that's too large
                if para_tokens > max_tokens:
                    # Split by bullets or sentences
                    sub_chunks = self._split_large_paragraph(para, max_tokens)
                    chunks.extend(sub_chunks[:-1])  # Add all but last
                    current_chunk = [sub_chunks[-1]] if sub_chunks else []
                    current_tokens = (
                        self.count_tokens(current_chunk[0]) if current_chunk else 0
                    )
                else:
                    current_chunk = [para]
                    current_tokens = para_tokens

        # Don't forget the last chunk
        if current_chunk:
            chunks.append("\n\n".join(current_chunk))

        return chunks if chunks else [content]

    def _process_text_section(self, section: ParsedSection) -> List[Document]:
        """
        Process a text section - split at paragraph/sentence boundaries.

        Args:
            section: Parsed text section

        Returns:
            List of OutputChunks
        """
        content = self._clean_content_for_chunk(section.raw_content)
        total_tokens = self.count_tokens(content)

        # If within limit, return as single chunk
        if total_tokens <= self.max_tokens:
            metadata = ChunkMetadata(
                page_start=section.metadata.page_start,
                page_header=section.metadata.page_header,
                hierarchy=section.metadata.hierarchy,
                section_context="COMPLETE",
                section_type=section.metadata.section_type,
                section_id=section.metadata.section_id,
                page=section.metadata.page,
                total_pages=section.metadata.total_pages,
            )
            # Add metadata header to content
            header = metadata.to_header()
            if header:
                content = f"{header}\n\n{content}"

            content = self._clean_chunk_headers(content)
            return [Document(page_content=content, metadata=metadata.to_dict())]

        # Need to split - try paragraph boundaries first
        available_tokens = self.max_tokens - self.METADATA_OVERHEAD
        text_chunks = self._split_text_by_boundaries(content, available_tokens)
        total_chunks = len(text_chunks)

        chunks = []
        for idx, text_content in enumerate(text_chunks, 1):
            metadata = ChunkMetadata(
                page_start=section.metadata.page_start,
                page_header=section.metadata.page_header,
                hierarchy=section.metadata.hierarchy,
                section_context=(
                    f"Part {idx} of {total_chunks}" if total_chunks > 1 else "COMPLETE"
                ),
                section_type=section.metadata.section_type,
                section_id=section.metadata.section_id,
                page=section.metadata.page,
                total_pages=section.metadata.total_pages,
            )
            # Add metadata header to content
            header = metadata.to_header()
            if header:
                text_content = f"{header}\n\n{text_content}"

            text_content = self._clean_chunk_headers(text_content)
            chunk = Document(page_content=text_content, metadata=metadata.to_dict())
            chunks.append(chunk)

        return chunks

    def _group_table_rows(
        self, rows: List[str], available_tokens: int
    ) -> List[List[str]]:
        """
        Group table rows into chunks that fit within token limit.

        Args:
            rows: List of table data rows
            available_tokens: Maximum tokens available for rows

        Returns:
            List of row groups
        """
        if not rows:
            return [[]]

        groups = []
        current_group = []
        current_tokens = 0

        for row in rows:
            row_tokens = self.count_tokens(row)

            if current_tokens + row_tokens <= available_tokens:
                current_group.append(row)
                current_tokens += row_tokens
            else:
                # Start new group
                if current_group:
                    groups.append(current_group)
                current_group = [row]
                current_tokens = row_tokens

        # Don't forget the last group
        if current_group:
            groups.append(current_group)

        return groups if groups else [[]]

    def _process_table_section(self, section: ParsedSection) -> List[Document]:
        """
        Process a table section - split at row boundaries with header repetition.

        Args:
            section: Parsed table section

        Returns:
            List of OutputChunks
        """
        # If no table structure parsed, treat as text
        if not section.table_header or not section.table_rows:
            return self._process_text_section(section)

        # Calculate token budgets
        header_tokens = self.count_tokens(section.table_header)
        separator_tokens = self.count_tokens(section.table_separator or "")
        title_tokens = self.count_tokens(section.table_title or "")
        metadata_tokens = self.METADATA_OVERHEAD

        # Available tokens for data rows per chunk
        available_per_chunk = (
            self.max_tokens
            - header_tokens
            - separator_tokens
            - title_tokens
            - metadata_tokens
        )

        # Group rows into chunks
        row_groups = self._group_table_rows(section.table_rows, available_per_chunk)
        total_chunks = len(row_groups)

        chunks = []
        for idx, row_group in enumerate(row_groups, 1):
            # Build metadata
            metadata = ChunkMetadata(
                page_start=section.metadata.page_start,
                page_header=section.metadata.page_header,
                hierarchy=section.metadata.hierarchy,
                section_context=(
                    f"Part {idx} of {total_chunks}" if total_chunks > 1 else "COMPLETE"
                ),
                section_type=section.metadata.section_type,
                section_id=section.metadata.section_id,
                page=section.metadata.page,
                total_pages=section.metadata.total_pages,
            )

            # Build content
            content_parts = []

            # Add title (with part number if split)
            if section.table_title:
                title = section.table_title
                if total_chunks > 1:
                    # Remove any existing (Part X of Y) pattern first
                    title = re.sub(r"\s*\(Part \d+ of \d+\)\s*", "", title).strip()
                    # Add new part number
                    title = f"{title} (Part {idx} of {total_chunks})"
                content_parts.append(title)
                content_parts.append("")

            # Add table header (repeated for each chunk)
            content_parts.append(section.table_header)
            if section.table_separator:
                content_parts.append(section.table_separator)

            # Add data rows for this chunk
            content_parts.extend(row_group)

            # Add footnotes only to last chunk
            if idx == total_chunks and section.footnotes:
                content_parts.append("")
                content_parts.append(section.footnotes)

            content = "\n".join(content_parts)

            # Add metadata header to content
            header = metadata.to_header()
            if header:
                content = f"{header}\n\n{content}"
            content = self._clean_chunk_headers(content)
            chunk = Document(page_content=content, metadata=metadata.to_dict())
            chunks.append(chunk)

        return chunks

    def split_text(self, text: str) -> list[Document]:  # type: ignore
        # Step 1: Extract document header (keep it separate)
        _, main_content = self._extract_document_header(text)

        # Step 2: Split by existing CHUNK_BOUNDARY markers
        raw_sections = self._split_by_boundary(main_content)

        # Step 3: Parse each section with metadata inheritance
        parsed_sections = []
        last_page_start = ""
        last_page_header = ""
        last_page = 0
        last_total_pages = 0

        for s in raw_sections:
            if not s.strip():
                continue
            section = self._parse_section(s)

            # Inherit missing page metadata from previous section
            if not section.metadata.page_start and last_page_start:
                section.metadata.page_start = last_page_start
                section.metadata.page = last_page
                section.metadata.total_pages = last_total_pages
            if not section.metadata.page_header and last_page_header:
                section.metadata.page_header = last_page_header

            # Update last known values
            if section.metadata.page_start:
                last_page_start = section.metadata.page_start
                last_page = section.metadata.page
                last_total_pages = section.metadata.total_pages
            if section.metadata.page_header:
                last_page_header = section.metadata.page_header

            parsed_sections.append(section)

        all_chunks: List[Document] = []
        for section in parsed_sections:
            if section.is_atomic:
                # Atomic sections: keep together regardless of size
                chunks = self._process_atomic_section(section)
            elif section.content_type == "TABLE":
                # Tables: split at row boundaries with header repetition
                chunks = self._process_table_section(section)
            else:
                # Text: split at paragraph/sentence boundaries
                chunks = self._process_text_section(section)

            all_chunks.extend(chunks)

        return all_chunks

