import os
from abc import ABC, abstractmethod
from typing import Any
import hashlib
from flask import g


class BaseDublinPipeline(ABC):
    """
    Base Dublin pipeline class
    """

    def __init__(self, file, overwrite: bool = False):
        self.file = file
        self.filename = file.filename
        self.overwrite = overwrite
        self.cursor = g.db.cursor()

    def _save_file(self, filepath: str) -> None:
        """
        Save file to filepath

        :param filepath: path to file
        :type filepath: str
        """
        self.file.save(filepath)

    def _remove_file(self, filepath: str) -> None:
        """
        Remove file from filepath

        :param filepath: path to file
        :type filepath: str
        """
        if os.path.exists(filepath):
            try:
                os.remove(filepath)
            except Exception as e:
                raise e

    def _calc_sha256(self, filepath: str, chunk_size: int = 4096) -> str:
        """
        Calculate SHA256 hash for the file

        :param chunk_size: File chunk size for hashing
        :type chunk_size: int
        :return: SHA256 hash of the file
        :rtype: str
        """
        sha256_hash = hashlib.sha256()
        with open(filepath, "rb") as f:
            for chunk in iter(lambda: f.read(chunk_size), b""):
                sha256_hash.update(chunk)

        self.file.seek(0)

        return sha256_hash.hexdigest()

    @abstractmethod
    def process(self) -> dict[str, Any]:
        pass
