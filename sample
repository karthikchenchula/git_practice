import os
from typing import Tuple, Union
from datetime import datetime

from langchain_community.document_loaders.excel import UnstructuredExcelLoader
from langchain_community.document_loaders.pdf import PyMuPDFLoader
from langchain_text_splitters import (
    RecursiveCharacterTextSplitter,
)
from gen_ai_hub.proxy.langchain.init_models import init_embedding_model
from langchain_hana import HanaDB

from common import DocumentExtensions
from util.file_util import extract_bank_code, extract_period
from embedding.markdown_documet_loader import MarkdownDocumentLoader
from embedding.smart_markdown_splitter import MarkdownSplitter


class EmbeddingProcessor:
    def __init__(
        self,
        context,
        filepath: Union[str, None] = None,
        filename: Union[str, None] = None,
    ) -> None:
        if filepath is None and filename is None:
            raise TypeError("Requred atleast one parameter filename or filepath")
        self.filepath = str(filepath)

        if filename:
            self.filename = filename
        else:
            self.filename = os.path.basename(self.filepath)
        self.ext = self.filename.split(".")[-1]
        self.context = context
        self.model = init_embedding_model(model_name=context.settings.embedding_model)
        self.vector_store = self._get_vector_store()

    def _get_document_loader(self):
        ouputpath = os.path.join(
            self.context.markdown_dir, self.filename.split(".")[0] + ".md"
        )
        if self.ext in DocumentExtensions.XLSX.value:
            return UnstructuredExcelLoader(self.filepath, mode="single")
        if (
            self.ext in DocumentExtensions.PDF.value
            and "transcript" in self.filename.lower()
        ):
            return PyMuPDFLoader(self.filepath, mode="page", extract_tables="markdown")
        if self.ext in DocumentExtensions.PDF.value:
            return MarkdownDocumentLoader(
                self.filepath, ouputpath, self.context.settings.markdown_model
            )

    def _get_vector_store(self):
        if self.ext in DocumentExtensions.XLSX.value:
            table_name = self.context.db_config["EXCEL_NON_TRANSCRIPT_TABLE"]
        elif (
            self.ext in DocumentExtensions.PDF.value
            and "transcript" in self.filename.lower()
        ):
            table_name = self.context.db_config["TRANSCRIPT_TABLE"]
        else:
            table_name = self.context.db_config["NON_TRANSCRIPT_TABLE"]

        return HanaDB(
            embedding=self.model, connection=self.context.db, table_name=table_name
        )

    def process(self) -> Tuple:
        loader = self._get_document_loader()
        excluded_pages = None
        try:
            self.vector_store.delete(filter={"filename": {"$eq": self.filename}})

            if (
                self.ext in DocumentExtensions.PDF.value
                and "transcript" not in self.filename.lower()
            ):
                split_document, excluded_pages = loader.load_and_split(  # type: ignore
                    # text_splitter=RecursiveCharacterTextSplitter(
                    #     separators=["<!-- CHUNK_BOUNDARY -->"],
                    #     chunk_size=1000,
                    #     chunk_overlap=200,
                    # )
                    text_splitter=MarkdownSplitter(
                        chunk_size=650,
                    )
                )
            else:
                split_document = loader.load_and_split(  # type: ignore
                    text_splitter=RecursiveCharacterTextSplitter(
                        chunk_size=1000, chunk_overlap=200
                    )
                )

            bank_code = extract_bank_code(self.filename, self.context.known_banks)
            period = extract_period(self.filename)
            creationdate = datetime.now().isoformat()

            for doc in split_document:
                page = doc.metadata.get("page", 0)  # type: ignore
                total_pages = doc.metadata.get("total_pages", 0)  # type: ignore
                doc.metadata = {  # type: ignore
                    "filename": self.filename,
                    "bank": bank_code,
                    "period": period,
                    "creationDate": creationdate,
                    "page": page,
                    "total_pages": total_pages,
                }

            self.vector_store.add_documents(split_document)  # type: ignore

            self.context.db.commit()
        except Exception as e:
            raise e

        return True, excluded_pages  # returns True to indicate complition

    def delete(self) -> None:
        try:
            self.vector_store.delete(filter={"filename": {"$eq": self.filename}})

        except Exception as e:
            raise e
