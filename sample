    else:
        logger.info(f"Auth using bound xsuaa instance {xsuaa_appname}")
        logger.debug(f"Client ID: {xsuaa_clientid}, Auth URL: {xsuaa_authurl}")
        return {
            "clientid": xsuaa_clientid,
            "clientsecret": xsuaa_clientsecret,
            "url": xsuaa_authurl,
            "xsappname": xsuaa_appname,
        }


def _verify_jwt_token(token, required_scope="uaa.resource"):
    """
    Verify jwt token for the provided scope in the xsuaa service
    """
    uaa_creds = current_app.uaa["credentials"]  # type: ignore

    try:
        security_context = xssec.create_security_context(token, uaa_creds)
        scope = security_context.check_scope(required_scope)
    except Exception as e:
        raise Unauthorized(f"Error: {e}")

    if not scope:
        current_app.logger.warning(f"Token missing required scope: {required_scope}")
        raise Forbidden("Forbidden: Insufficient scope")

    current_app.logger.info("Token successfully verified and scope present.")

    return security_context


def validate_auth(auth_header: str = None):  # type: ignore
    """
    Enforce XSUAA JWT authentication and scope check on endpoints.
    - Expects 'Authorization: Bearer <token>' header in the request.
    - Returns 401 if header is missing/invalid, 403 if token is invalid or lacks required scope.
    """
    auth_enabled = current_app.settings.auth_enabled  # type: ignore
    if auth_enabled == "true" or os.getenv("VCAP_APPLICATION") is not None:
        if auth_header is None or not auth_header.startswith("Bearer "):
            raise Unauthorized("Authorization header missing or invalid")

        token = auth_header.replace("Bearer ", "", 1)

        _verify_jwt_token(token)

