    localpath = settings.localpath
    cachepath = settings.cachepath

    # Define directory paths
    documents_dir = os.path.join(localpath, cachepath, "Documents")
    images_dir = os.path.join(localpath, cachepath, "Images")
    embeddings_dir = os.path.join(localpath, cachepath, "Embeddings")
    summary_dir = os.path.join(localpath, cachepath, "Summary")
    markdown_dir = os.path.join(localpath, cachepath, "Markdown")

    # Create directories if not exists
    os.makedirs(documents_dir, exist_ok=True)
    os.makedirs(images_dir, exist_ok=True)
    os.makedirs(embeddings_dir, exist_ok=True)
    os.makedirs(summary_dir, exist_ok=True)
