import os
from datetime import datetime, timezone

from gen_ai_hub.orchestration_v2.models.llm_model_details import LLMModelDetails
from gen_ai_hub.orchestration_v2.models.message import UserMessage, SystemMessage
from gen_ai_hub.orchestration_v2.models.template import Template
from gen_ai_hub.orchestration_v2.service import OrchestrationService

from langchain_community.document_loaders.excel import UnstructuredExcelLoader
from langchain_community.document_loaders.pdf import PyMuPDFLoader

from services.orchestration import OrchestrationClient
from util.file_util import get_token_count
from .report import PDFGenerator
from common import DocumentExtensions
from db.sql import INSERT_SUMMARY_FILE
from summary.prompt import SUMMARY_PROMPT, SYSTEM_MESSAGE


class SummaryProcessor:
    def __init__(self, filepath: str, context) -> None:
        self.context = context
        self.filepath = filepath
        self.filename = os.path.basename(self.filepath)
        self.ext = "." + self.filename.split(".")[-1]
        self.summhay_file = os.path.join(
            self.context.settings.localpath, "summary", "summary_agent_SummHay.txt"
        )
        # Claude 4.5 Sonnet has 200k context window
        self.context_window = 200000

    def _get_orchestration_model(self, prompt: str, system_message: str = None) -> OrchestrationService:
        llm = LLMModelDetails(
            name=self.context.settings.summary_model,
            params={"temperature": 0.2, "max_tokens": 200000},
        )

        # Claude 4.5 works better with system messages for role definition
        messages = []
        if system_message:
            messages.append(SystemMessage(content=system_message))
        messages.append(UserMessage(content=prompt))
        
        template = Template(template=messages)

        return OrchestrationClient(llm=llm, template=template).client()

    def _extract_text(self) -> str:
        if self.ext in DocumentExtensions.XLSX.value:
            loader = UnstructuredExcelLoader(self.filepath, mode="single")
        if self.ext in DocumentExtensions.PDF.value:
            loader = PyMuPDFLoader(
                self.filepath, mode="single", extract_tables="markdown"
            )
        documents = loader.load()  # type: ignore
        return " ".join(doc.page_content for doc in documents)

    def process(self) -> bool:
        self.context.logger.info(f"Generating summary for file {self.filename}")

        with open(self.summhay_file, "r", encoding="utf-8") as file:
            coda_text = file.read()

        text = self._extract_text()
        cursor = self.context.db.cursor()
        output_file = None

        prompt = SUMMARY_PROMPT.format(coda_text=coda_text, text=text)
        try:
            # Check total token count including system message
            total_prompt = SYSTEM_MESSAGE + "\n\n" + prompt
            if get_token_count(total_prompt) <= self.context_window:
                orch_srv = self._get_orchestration_model(prompt, SYSTEM_MESSAGE)
                # Increase timeout for Claude 4.5 as it may take longer to process
                response = orch_srv.run(timeout=600)
                summary = response.final_result.choices[0].message.content
            else:
                self.context.logger.error("Input text is too large to process.")
                raise ValueError("Input text is too large to process.")

            generator = PDFGenerator(
                filename=self.filename, output_dir=self.context.summary_dir
            )
            output_file = generator.generate(
                description="SummHay Methodology Summary", summary=summary  # type: ignore
            )

            with open(output_file, "rb") as file:
                file_bytes = file.read()

            cursor.execute(
                INSERT_SUMMARY_FILE.format(
                    schema=self.context.db_config["SCHEMA"],
                    table=self.context.db_config["SUMMARY_FILE"],
                ),
                {
                    "filename": self.filename,
                    "file_type": "Original",
                    "file_extension": self.ext,
                    "timestamp": datetime.now(timezone.utc),
                    "summary_blob": file_bytes,
                },
            )

            self.context.db.commit()

            self.context.logger.info(
                f"Summary for file {self.filename} generated successfully."
            )

        except Exception as e:
            self.context.logger.error(f"Error generating summary: {str(e)}")
            raise Exception(f"Error generating summary: {str(e)}")
        finally:
            if output_file:
                os.remove(output_file)

        return True  # returns True to indicate complition

