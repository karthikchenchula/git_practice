# Import standard modules
from flask import Flask, request, jsonify
from werkzeug.exceptions import HTTPException

# Import project modules
from blueprints.api import api
from blueprints.root import root
from common import load_settings, set_file_size, init_services
from util import init_dirs, init_logging
from services.xsuaa import validate_auth

# Define Flask application
app = Flask(__name__)

# Register Blueprints
app.register_blueprint(api)
app.register_blueprint(root)

# Load Resources with application context
with app.app_context():
    load_settings()
    init_logging(app)
    init_dirs()
    set_file_size()
    init_services()


@app.before_request
def global_middleware():
    auth_header = request.headers.get("Authorization", None)
    validate_auth(auth_header)  # type: ignore


# Register HTTP Error Handlers
@app.errorhandler(HTTPException)
def handle_http_exception(e):
    """Return JSON instead of HTML for HTTP errors."""
    response = e.get_response()

    # Special handling for Error code 413
    if e.code == 413:
        e.description = f"File too large. Maximum size is {app.settings.max_file_size} MB."  # type: ignore

    # replace the body with JSON
    response.data = jsonify(
        {
            "code": e.code,
            "name": e.name,
            "description": e.description,
        }
    ).data
    response.content_type = "application/json"
    return response


# Register Generic Error Handlers
@app.errorhandler(Exception)
def handle_exception(e):
    """Handle non-HTTP exceptions and return a generic JSON error."""
    # Log the full traceback for unexpected errors
    app.logger.error("An unhandled exception occurred", exc_info=True)
    return (
        jsonify(
            {
                "code": 500,
                "name": "Internal Server Error",
                "description": "An unexpected error occurred. Please try again later.",
            }
        ),
        500,
    )

