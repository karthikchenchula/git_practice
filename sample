from gen_ai_hub.orchestration_v2.service import OrchestrationService
from gen_ai_hub.orchestration_v2.exceptions import OrchestrationError

from tenacity import (
    retry,
    stop_after_attempt,
    wait_exponential,
    retry_if_exception_type,
    before_sleep_log,
)

from langchain_text_splitters import TextSplitter
from langchain_core.documents import Document

from embedding.prompts import EXTRACTION_PROMPT
from services.orchestration import OrchestrationClient

logger = logging.getLogger("markdown-loader")
handler = logging.StreamHandler(sys.stdout)
handler.setFormatter(
    logging.Formatter(
        "[%(asctime)s,%(msecs)03d] %(levelname)s in %(name)s: %(message)s",
        datefmt="%Y-%m-%d %H:%M:%S",
    )
)
logger.addHandler(handler)
logger.setLevel(logging.DEBUG)

# Suppress errors from being printed in STDOUT
pymupdf.TOOLS.mupdf_display_errors(False)

# Maximum allowed image size by the LLM in bytes (5 MB)
# MAX_IMAGE_SIZE_BYTES = 10485760
MAX_IMAGE_SIZE_BYTES = 5242880


class MarkdownDocumentLoader:
    """
    Class to extract PDF content as Markdown
    """

    def __init__(self, file: str, output: str, model: str) -> None:
        self.filepath = file
        self.outputpath = output
        self.model = model

        image = ImageItem(url="data:image/png;base64,{{?image_bytes}}")

        template = Template(template=[UserMessage(content=[image, EXTRACTION_PROMPT])])

        self.client = self._get_orchestration_model(template)

    def _get_orchestration_model(self, template: Template) -> OrchestrationService:

        llm = LLMModelDetails(
            name=self.model,
            params={"temperature": 0.1, "max_tokens": 200000},
        )

        return OrchestrationClient(llm=llm, template=template).client()

    @retry(
        retry=retry_if_exception_type((Exception)),
        wait=wait_exponential(multiplier=3, min=5, max=60),
        stop=stop_after_attempt(5),
        before_sleep=before_sleep_log(logger, logging.WARNING),
        reraise=True,
    )
    async def _extarct_as_markdown(
        self,
        page_bytes: bytes,
        page_num: int,
        total_pages: int,
        semaphore: asyncio.Semaphore,
    ) -> str:

        async with semaphore:
            try:
                response = await self.client.arun(
                    placeholder_values={
                        "page_num": str(page_num),
                        "total_pages": str(total_pages),
                        "image_bytes": base64.b64encode(page_bytes).decode("utf-8"),
                    },
                    timeout=180,
                )
            except OrchestrationError as e:
                logger.warning(
                    f"Orchestration Request failed for page {page_num} with request id: {e.request_id}"
                )
                raise e
            except Exception as e:
                raise e

            return response.final_result.choices[0].message.content  # type: ignore

    def load_and_split(
        self, text_splitter: TextSplitter, max_concurrent: int = 5
    ) -> List[Document]:

        semaphore = asyncio.Semaphore(max_concurrent)

        async def process_page(page, page_num: int, total_pages: int, dpi: int = 300):
            try:
                # Initial extraction
                zoom = dpi / 72
                matrix = pymupdf.Matrix(zoom, zoom)
                pixmap = page.get_pixmap(matrix=matrix)
                bytes_data = pixmap.tobytes("png")

                # Check if image size exceeds the limit
                if len(bytes_data) > MAX_IMAGE_SIZE_BYTES:
                    logger.warning(
                        f"Page {page_num} image size ({len(bytes_data)} bytes) exceeds limit ({MAX_IMAGE_SIZE_BYTES} bytes)"
                    )
                    
                    # Fallback DPI values to try progressively
                    # fallback_dpis = [200, 150, 100, 75, 50]
                    
                    # for fallback_dpi in fallback_dpis:
                    #     zoom = fallback_dpi / 72
                    #     matrix = pymupdf.Matrix(zoom, zoom)
                    #     pixmap = page.get_pixmap(matrix=matrix)
                    #     bytes_data = pixmap.tobytes("png")
                        
                    #     if len(bytes_data) <= MAX_IMAGE_SIZE_BYTES:
                    #         logger.info(
                    #             f"Successfully reduced page {page_num} image size to {len(bytes_data)} bytes using DPI {fallback_dpi}"
                    #         )
                    #         break
                    #     else:
                    #         # If even the lowest DPI produces an image that's too large
                    #         raise Exception(
                    #             f"Unable to reduce page {page_num} image size below {MAX_IMAGE_SIZE_BYTES} bytes. "
                    #             f"Current size: {len(bytes_data)} bytes at DPI {fallback_dpis[-1]}"
                    #         )
                    return page_num, None, None, True

                else:
                    markdown_output = await self._extarct_as_markdown(
                        page_bytes=bytes_data,
                        page_num=page_num,
                        total_pages=total_pages,
                        semaphore=semaphore,
                    )

                    logger.info(
                        f"Completed Processing page {page_num} of file {self.filepath}"
                    )

                    return page_num, markdown_output, None, False
            except Exception as e:
                logger.error(
                    f"Error while processing page {page_num} of file {self.filepath}: {str(e)}"
                )
                return page_num, None, str(e), False

        async def process_file(filepath: str):
            file = pymupdf.open(filepath)

            tasks = []
            for page in file:
                page_number = page.number + 1  # type: ignore
                total_pages = len(file)
                tasks.append(
                    asyncio.create_task(process_page(page, page_number, total_pages))
                )

            # try:
            results = await asyncio.gather(*tasks, return_exceptions=False)

            results.sort(key=lambda x: x[0])

            failed = [
                (num, error) for num, content, error, excluded in results if error is not None and not excluded
            ]

            excluded = [
                num for num, content, error, excluded in results if excluded
            ]

            # Add failed pages to excluded list
            for num, _ in failed:
                excluded.append(num)

            # if len(failed) > 0:
            #     raise Exception(
            #         f"Unable to process {len(failed)} pages of document {self.filepath}"
            #     )
            # except Exception as e:
            #     for t in tasks:
            #         t.cancel()
            #     raise e

            return results, excluded

        results, excluded = asyncio.run(process_file(self.filepath))

        markdown_content = ""

        for _, markdown_output, _, exc in results:
            if markdown_output is not None and not exc:
                markdown_content += markdown_output + "\n\n"

        # with open("./output.md", 'w') as file:
        #     file.write(markdown_content)

        chunks = text_splitter.split_text(markdown_content)

        # documents = [Document(page_content=content) for content in chunks]

        return chunks, excluded  # type: ignore

