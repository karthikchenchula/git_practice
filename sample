from flask import current_app, g
from httpx import HTTPError
from werkzeug.exceptions import BadRequest

from services.cap import CAPService
from embedding.processor import EmbeddingProcessor
from common import DocumentExtensions, ImageExtensions
from db.sql import DELETE_IMAGE, DELETE_DUBLIN_METADTA, DELETE_SUMMARY_FILE


class DeletePipeline:
    def __init__(self, document_id: str) -> None:
        self.document_id = document_id
        self.client = CAPService(current_app.settings.cap_destination).get_client()  # type: ignore
        self.db = g.db
        self.db_config = g.db_config
        self.settings = current_app.settings  # type: ignore
        self.logger = current_app.logger

    def delete(self) -> dict[str, str]:
        try:
            res = self.client.get(f"/odata/v4/catalog/Content/{self.document_id}")
            res.raise_for_status()

            data = res.json()

        except HTTPError as e:
            current_app.logger.error(
                f"Error while generating embeddings for document {self.document_id}. Error: {e}"
            )
            if e.response.status_code == 404:  # type: ignore
                raise BadRequest(
                    f"Document {self.document_id} not found. Please check the document ID."
                )
            else:
                raise e
        except Exception as e:
            raise e

        filename = data.get("fileName")
        file_ext = "." + filename.split(".")[-1]
        msg = ""
        cursor = self.db.cursor()

        try:
            msg += f"Metadata deletion for file {filename} "

            cursor.execute(
                DELETE_DUBLIN_METADTA.format(
                    schema=g.db_config["SCHEMA"], table=g.db_config["DUBLIN_TABLE"]
                ),
                {"filename": filename},
            )

            msg += "completed."
        except Exception as e:
            self.logger.error(f"Error during Embedding deletion. Error: {e}")
            msg += "failed"

        if DocumentExtensions.has_value(file_ext):
            msg += f"Embedding deletion for file {filename} "

            try:
                processor = EmbeddingProcessor(filename=filename, context=self)

                processor.delete()

                msg += "completed."
            except Exception as e:
                self.db.rollback()
                self.logger.error(f"Error during Embedding deletion. Error: {e}")
                msg += "failed"
        elif ImageExtensions.has_value(file_ext):
            msg += f"Deletion of file {filename} from Image table "

            try:
                cursor.execute(
                    DELETE_IMAGE.format(
                        schema=g.db_config["SCHEMA"], table=g.db_config["IMAGE_TABLE"]
                    ),
                    {"filename": filename},
                )

                msg += "completed."
            except Exception as e:
                self.db.rollback()
                self.logger.error(f"Error during Image deletion. Error: {e}")
                msg += "failed"
        else:
            raise BadRequest(f"Unknown file type with exctension {file_ext}")

        try:
            msg += f"Delete of Summary report for file {filename} from Summary table "

            cursor.execute(
                DELETE_SUMMARY_FILE.format(
                    schema=g.db_config["SCHEMA"], table=g.db_config["SUMMARY_FILE"]
                ),
                {"filename": filename},
            )

            msg += "completed."
        except Exception as e:
            self.db.rollback()
            self.logger.error(f"Error during Summary deletion. Error: {e}")
            msg += "failed"

        self.db.commit()
        cursor.close()

        return {"message": msg}

