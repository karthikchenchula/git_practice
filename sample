class Hana:
    def __init__(
        self,
        address: Union[str, None] = None,
        port: Union[str, None] = None,  # type: ignore
        user: Union[str, None] = None,  # type: ignore
        password: Union[str, int] = None,  # type: ignore
        schema: Union[str, None] = None,
        dest_name: Union[str, None] = None,  # type: ignore
    ):
        logger = current_app.logger

        if not all([address, port, user, password]) and dest_name is None:
            raise TypeError("Required either connection details or destination name")
        else:
            self.dest_name = dest_name
            if dest_name:
                logger.info("Initializing Hana credentials from destination...")
                address, port, user, password, schema = self._get_details_from_dest()  # type: ignore

            self.address = address
            self.port = port
            self.user = user
            self.password = password
            self.schema = schema

            logger.info("Initialized Hana credentials.")
            logger.debug(
                f"address: {address}, port: {port}, user: {user}, password: {sanitize(password)}"  # type: ignore
            )

    def _get_details_from_dest(self):
        dest = Destination(self.dest_name)  # type: ignore

        config = dest.get_config()

        address = re.sub(r"^https?:\/\/", "", config.get("URL"))  # type: ignore
        port = config.get("Port")
        user = config.get("User")
        password = config.get("Password")
        schema = config.get("schema")

        if not all([address, port, user, password, schema]):
            raise Exception(
                f"Missing connection details. Please check the destination {self.dest_name}"
            )

        return (address, int(port), user, password, schema)  # type: ignore

    def get_current_schema(self):
        return self.schema

    def connection(self, autocommit: bool = False):
        conn = dbapi.connect(
            address=self.address,
            port=self.port,
            user=self.user,
            password=self.password,
            encrypt=True,  # type: ignore
            sslValidateCertificate=False,  # type: ignore
            autocommit=autocommit,
        )

        return conn

