@dataclass
class ChunkMetadata:
    """Metadata for a single chunk, extracted from source markers."""

    page_start: str = ""  # e.g., "2 of 31"
    page_header: str = ""  # e.g., "CITIGROUP FINANCIAL SUMMARY"
    hierarchy: str = ""  # e.g., "Citigroup Financial Summary > Revenue..."
    section_context: str = ""  # e.g., "Part 1 of 4" or "COMPLETE" or "ATOMIC"
    section_type: str = ""  # "LONG_TABLE" | "SIMPLE_TABLE" | "TEXT" | "CHART"
    section_id: str = ""  # Original section ID
    page: int = 0  # Current page number
    total_pages: int = 0  # Total pages in document

    def to_header(self) -> str:
        """Generate chunk header from metadata."""
        lines = []
        if self.page_start:
            lines.append(f"<!-- PAGE_START: {self.page_start} -->")
        if self.page_header:
            lines.append(f"<!-- PAGE_HEADER: {self.page_header} -->")
        if self.hierarchy:
            lines.append(f"<!-- HIERARCHY: {self.hierarchy} -->")
        if self.section_id:
            lines.append(f"<!-- SECTION_ID: {self.section_id} -->")
        if self.section_context:
            lines.append(f"<!-- Section_Context: {self.section_context} -->")
        return "\n".join(lines)

    def to_dict(self) -> dict:
        return {
            "page_start": self.page_start,
            "page_header": self.page_header,
            "hierarchy": self.hierarchy,
            "section_context": self.section_context,
            "section_type": self.section_type,
            "section_id": self.section_id,
            "page": self.page,
            "total_pages": self.total_pages,
        }


