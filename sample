import json
import os
import threading
from typing import Any
from flask import current_app, g
from httpx import HTTPError
from werkzeug.exceptions import BadRequest

from services.cap import CAPService
from embedding.processor import EmbeddingProcessor
from summary.processor import SummaryProcessor
from db.factory import HanaFactory


class EmbeddingPipeline:
    def __init__(self, document_id: str, use_case: str) -> None:
        self.document_id = document_id
        self.client = CAPService(current_app.settings.cap_destination).get_client()  # type: ignore
        self.embed_dir = current_app.config.get("EMBEDDING_DIR")
        self.summary_dir = current_app.config.get("SUMMARY_DIR")
        self.markdown_dir = current_app.config.get("MARKDOWN_DIR")
        factory, config = HanaFactory(use_case).init()  # type: ignore
        self.db = factory.connection()
        self.db_config = config
        self.known_banks = g.KNOWN_BANKS
        self.settings = current_app.settings  # type: ignore
        self.logger = current_app.logger

    def _save_file(self, path: str) -> None:
        try:
            res = self.client.get(
                f"/odata/v4/catalog/Content('{self.document_id}')/content"
            )
            res.raise_for_status()

            data = res.content

            with open(path, "wb") as file:
                file.write(data)  # type: ignore
        except Exception as e:
            raise e

    def _remove_file(self, filepath: str) -> None:
        if os.path.exists(filepath):
            try:
                os.remove(filepath)
            except Exception as e:
                raise e

    def _background_task(self, filepath: str):
        embed_status = False
        exclusion_msg = ""

        try:
            self.logger.info(
                f"Strating Embedding generation for {self.document_id} in the background"
            )

            processor = EmbeddingProcessor(filepath=filepath, context=self)

            embed_status, excluded_pages = processor.process()

            if excluded_pages and len(excluded_pages) > 0:
                exclusion_msg = f"excluding pages {', '.join(map(str, excluded_pages))} due to image size constraints"

            self.logger.info(
                f"Embedding generation for {self.document_id} is Completed {exclusion_msg}"
            )

            SummaryProcessor(filepath=filepath, context=self).process()

            self.db.close()

            self.client.patch(
                f"/odata/v4/catalog/Content('{self.document_id}')",
                json={"status": "COMPLETED", "status_reason": exclusion_msg},
            )

        except Exception as e:
            status = "PARTIALLY COMPLETED" if embed_status else "FAILED"
            status_reason = (
                f"Document ready for prompting {exclusion_msg} and Summary generation failed"
                if embed_status
                else "Embedding and Summary generation failed."
            )

            self.client.patch(
                f"/odata/v4/catalog/Content('{self.document_id}')",
                json={"status": status, "status_reason": status_reason},
            )

            self.logger.info(
                f"Embedding generation for {self.document_id} is Failed with error. Error: {e}"
            )
            raise e
        finally:
            self._remove_file(filepath)

    def process(self) -> dict[str, Any]:  # type: ignore
        try:
            res = self.client.get(f"/odata/v4/catalog/Content/{self.document_id}")
            res.raise_for_status()

            data = res.json()

        except HTTPError as e:
            current_app.logger.error(
                f"Error while generating embeddings for document {self.document_id}. Error: {e}"
            )
            if e.response.status_code == 404:  # type: ignore
                raise BadRequest(
                    f"Document {self.document_id} not found. Please check the document ID."
                )
            else:
                raise e
        except Exception as e:
            raise e

        status = data.get("status")
        filename = data.get("fileName")
        metadata = json.loads(data.get("metaData")).get("metadata")

        if status.lower() == "processing":
            filepath = os.path.join(self.embed_dir, filename)  # type: ignore

            self._save_file(filepath)

            thread = threading.Thread(
                target=self._background_task, kwargs={"filepath": filepath}, daemon=True
            )
            thread.start()

            return {"message": f"Generating embeddings for {self.document_id}"}
        else:
            raise BadRequest(
                f"Unable to generate embedding for {self.document_id} with dublin decision {metadata.get('decision') if metadata else 'Unknown'} and status {status}"
            )
